# Server
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./db/toolkit.db

# Vault encryption (REQUIRED — app will not start without this)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=

# File upload
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=10

# App auth
# In production, set both values unless you explicitly opt out with APP_AUTH_DISABLED=true.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
APP_AUTH_DISABLED=false
