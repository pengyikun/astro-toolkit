# Server
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./db/toolkit.db

# Vault encryption (REQUIRED — app will not start without this)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=

# File upload
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=10

# App auth
# Required for session and download-token signing. Must differ from VAULT_ENCRYPTION_KEY.
AUTH_SECRET=
APP_AUTH_DISABLED=false

# WhatsApp (optional — path to whatsapp-mcp messages.db)
WHATSAPP_DB_PATH=
