<%- include('../partials/header') %>

<%
  const statusColors = {
    success: 'bg-green-100 text-green-800',
    pending: 'bg-yellow-100 text-yellow-800',
    failed: 'bg-red-100 text-red-800',
    timeout: 'bg-gray-100 text-gray-800',
    returned: 'bg-blue-100 text-blue-800',
  };

  function formatJson(str) {
    if (!str) return null;
    try { return JSON.stringify(JSON.parse(str), null, 2); }
    catch { return str; }
  }
%>

<div class="max-w-3xl">
  <div class="mb-6">
    <a href="/penny-log" class="text-sm text-gray-500 hover:text-gray-700">← Back to Penny Test Log</a>
  </div>

  <div class="flex items-start justify-between mb-6">
    <div>
      <h2 class="text-2xl font-semibold text-gray-900">Log #<%= log.id %></h2>
      <div class="flex items-center gap-2 mt-2">
        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= statusColors[log.status] || 'bg-gray-100 text-gray-600' %>">
          <%= log.status %>
        </span>
        <span class="text-sm text-gray-500"><%= log.partner_name %></span>
        <span class="text-gray-300">·</span>
        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium
          <%= log.direction === 'inbound' ? 'bg-indigo-100 text-indigo-700' : 'bg-teal-100 text-teal-700' %>">
          <%= log.direction %>
        </span>
      </div>
    </div>
    <div class="flex gap-2">
      <a href="/penny-log/<%= log.id %>/edit"
         class="px-4 py-2 text-sm font-medium rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors">
        Edit
      </a>
      <button type="button"
              onclick="openConfirmModal('/penny-log/<%= log.id %>?_method=DELETE', 'Delete Log Entry', 'Are you sure you want to delete this log entry?')"
              class="px-4 py-2 text-sm font-medium rounded-lg bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 transition-colors">
        Delete
      </button>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Transaction Details</h3>
    <dl class="grid grid-cols-2 gap-x-8 gap-y-4">
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Partner</dt>
        <dd class="text-sm text-gray-900 mt-0.5"><%= log.partner_name %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Direction</dt>
        <dd class="text-sm text-gray-900 mt-0.5"><%= log.direction %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Amount</dt>
        <dd class="text-sm text-gray-900 mt-0.5 font-mono"><%= log.amount %> <%= log.currency %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Status</dt>
        <dd class="mt-0.5">
          <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= statusColors[log.status] || 'bg-gray-100 text-gray-600' %>">
            <%= log.status %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Reference ID</dt>
        <dd class="text-sm text-gray-900 mt-0.5 font-mono"><%= log.reference_id || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Tested At</dt>
        <dd class="text-sm text-gray-900 mt-0.5"><%= log.tested_at ? new Date(log.tested_at).toLocaleString() : '—' %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Linked Account</dt>
        <dd class="text-sm mt-0.5">
          <% if (account) { %>
            <a href="/accounts/<%= account.id %>" class="text-blue-600 hover:text-blue-700 font-medium"><%= account.name %></a>
          <% } else { %>
            <span class="text-gray-300">—</span>
          <% } %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Created</dt>
        <dd class="text-sm text-gray-900 mt-0.5"><%= new Date(log.created_at).toLocaleString() %></dd>
      </div>
    </dl>
  </div>

  <% if (log.error_code || log.error_message) { %>
    <div class="bg-white rounded-xl border border-red-200 p-6 mb-6">
      <h3 class="text-sm font-semibold text-red-500 uppercase tracking-wide mb-4">Error Details</h3>
      <dl class="grid grid-cols-2 gap-x-8 gap-y-4">
        <% if (log.error_code) { %>
          <div>
            <dt class="text-xs font-medium text-gray-400 uppercase">Error Code</dt>
            <dd class="text-sm text-red-700 mt-0.5 font-mono"><%= log.error_code %></dd>
          </div>
        <% } %>
        <% if (log.error_message) { %>
          <div class="<%= log.error_code ? '' : 'col-span-2' %>">
            <dt class="text-xs font-medium text-gray-400 uppercase">Error Message</dt>
            <dd class="text-sm text-red-700 mt-0.5"><%= log.error_message %></dd>
          </div>
        <% } %>
      </dl>
    </div>
  <% } %>

  <% if (log.request_payload) { %>
    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Request Payload</h3>
      <pre class="bg-gray-50 rounded-lg p-4 text-xs text-gray-800 font-mono overflow-x-auto whitespace-pre-wrap"><%= formatJson(log.request_payload) %></pre>
    </div>
  <% } %>

  <% if (log.response_payload) { %>
    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Response Payload</h3>
      <pre class="bg-gray-50 rounded-lg p-4 text-xs text-gray-800 font-mono overflow-x-auto whitespace-pre-wrap"><%= formatJson(log.response_payload) %></pre>
    </div>
  <% } %>

  <% if (log.notes) { %>
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Notes</h3>
      <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= log.notes %></p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>