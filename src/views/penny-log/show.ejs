<%- include('../partials/header') %>

<%
  const statusColors = {
    success: 'bg-success-light text-success',
    pending: 'bg-warning-light text-warning',
    failed: 'bg-danger-light text-danger',
    timeout: 'bg-page text-ink-secondary',
    returned: 'bg-brand-light text-brand',
  };
  const statusDotColors = {
    success: 'bg-success',
    pending: 'bg-warning',
    failed: 'bg-danger',
    timeout: 'bg-ink-muted',
    returned: 'bg-brand',
  };

  function formatJson(str) {
    if (!str) return null;
    try { return JSON.stringify(JSON.parse(str), null, 2); }
    catch { return str; }
  }
%>

<div class="max-w-4xl">
  <div class="mb-6">
    <a href="/penny-log" class="text-[13px] text-ink-secondary hover:text-ink">← Back to Test Transactions</a>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3">
        <h2 class="text-xl font-semibold text-ink">Transaction #<%= log.id %></h2>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium <%= statusColors[log.status] || 'bg-page text-ink-secondary' %>">
          <span class="w-1.5 h-1.5 rounded-full <%= statusDotColors[log.status] || 'bg-ink-muted' %>"></span>
          <%= log.status.charAt(0).toUpperCase() + log.status.slice(1) %>
        </span>
      </div>
      <div class="flex items-center gap-2 mt-1.5">
        <span class="text-[13px] text-ink-secondary"><%= log.partner_name %></span>
        <span class="text-ink-muted">·</span>
        <span class="inline-flex items-center gap-1 text-xs font-medium
          <%= log.direction === 'inbound' ? 'text-[#4f46e5]' : 'text-success' %>">
          <% if (log.direction === 'inbound') { %>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" /></svg>
          <% } else { %>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" /></svg>
          <% } %>
          <%= log.direction %>
        </span>
      </div>
    </div>
    <div class="flex gap-2">
      <a href="/penny-log/<%= log.id %>/edit"
         class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium rounded-lg border border-border text-ink hover:bg-page transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" /></svg>
        Edit
      </a>
      <button type="button"
              onclick="openConfirmModal('/penny-log/<%= log.id %>?_method=DELETE', 'Delete Transaction', 'Are you sure you want to delete this transaction?')"
              class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium rounded-lg text-danger border border-danger-border hover:bg-danger-light transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
        Delete
      </button>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-border p-6 mb-5">
    <h3 class="text-xs font-semibold text-ink-secondary uppercase tracking-wider mb-5">Transaction Details</h3>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5">
      <div>
        <dt class="text-[11px] font-medium text-ink-muted uppercase tracking-wider">Partner</dt>
        <dd class="text-sm text-ink mt-1"><%= log.partner_name %></dd>
      </div>
      <div>
        <dt class="text-[11px] font-medium text-ink-muted uppercase tracking-wider">Direction</dt>
        <dd class="text-sm text-ink mt-1"><%= log.direction %></dd>
      </div>
      <div>
        <dt class="text-[11px] font-medium text-ink-muted uppercase tracking-wider">Amount</dt>
        <dd class="text-sm text-ink mt-1 font-mono"><%= log.amount %> <%= log.currency %></dd>
      </div>
      <div>
        <dt class="text-[11px] font-medium text-ink-muted uppercase tracking-wider">Status</dt>
        <dd class="mt-1">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium <%= statusColors[log.status] || 'bg-page text-ink-secondary' %>">
            <span class="w-1.5 h-1.5 rounded-full <%= statusDotColors[log.status] || 'bg-ink-muted' %>"></span>
            <%= log.status.charAt(0).toUpperCase() + log.status.slice(1) %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="text-[11px] font-medium text-ink-muted uppercase tracking-wider">Reference ID</dt>
        <dd class="text-sm text-ink mt-1 font-mono"><%= log.reference_id || '—' %></dd>
      </div>
      <div>
        <dt class="text-[11px] font-medium text-ink-muted uppercase tracking-wider">Tested At</dt>
        <dd class="text-sm text-ink mt-1"><%= log.tested_at ? new Date(log.tested_at).toLocaleString() : '—' %></dd>
      </div>
      <div>
        <dt class="text-[11px] font-medium text-ink-muted uppercase tracking-wider">Linked Account</dt>
        <dd class="text-sm mt-1">
          <% if (account) { %>
            <a href="/accounts/<%= account.id %>" class="text-brand hover:text-brand-dark font-medium"><%= account.name %></a>
          <% } else { %>
            <span class="text-ink-muted">—</span>
          <% } %>
        </dd>
      </div>
      <div>
        <dt class="text-[11px] font-medium text-ink-muted uppercase tracking-wider">Created</dt>
        <dd class="text-sm text-ink mt-1"><%= new Date(log.created_at).toLocaleString() %></dd>
      </div>
    </dl>
  </div>

  <% if (log.error_code || log.error_message) { %>
    <div class="bg-white rounded-xl border border-danger-border p-6 mb-5">
      <h3 class="text-xs font-semibold text-danger uppercase tracking-wider mb-5">Error Details</h3>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5">
        <% if (log.error_code) { %>
          <div>
            <dt class="text-[11px] font-medium text-ink-muted uppercase tracking-wider">Error Code</dt>
            <dd class="text-sm text-danger mt-1 font-mono"><%= log.error_code %></dd>
          </div>
        <% } %>
        <% if (log.error_message) { %>
          <div class="<%= log.error_code ? '' : 'col-span-2' %>">
            <dt class="text-[11px] font-medium text-ink-muted uppercase tracking-wider">Error Message</dt>
            <dd class="text-sm text-danger mt-1"><%= log.error_message %></dd>
          </div>
        <% } %>
      </dl>
    </div>
  <% } %>

  <% if (log.request_payload) { %>
    <div class="bg-white rounded-xl border border-border p-6 mb-5">
      <h3 class="text-xs font-semibold text-ink-secondary uppercase tracking-wider mb-4">Request Payload</h3>
      <pre class="bg-page rounded-md p-4 text-xs text-ink font-mono overflow-x-auto whitespace-pre-wrap border border-border"><%= formatJson(log.request_payload) %></pre>
    </div>
  <% } %>

  <% if (log.response_payload) { %>
    <div class="bg-white rounded-xl border border-border p-6 mb-5">
      <h3 class="text-xs font-semibold text-ink-secondary uppercase tracking-wider mb-4">Response Payload</h3>
      <pre class="bg-page rounded-md p-4 text-xs text-ink font-mono overflow-x-auto whitespace-pre-wrap border border-border"><%= formatJson(log.response_payload) %></pre>
    </div>
  <% } %>

  <% if (log.notes) { %>
    <div class="bg-white rounded-xl border border-border p-6">
      <h3 class="text-xs font-semibold text-ink-secondary uppercase tracking-wider mb-4">Notes</h3>
      <p class="text-sm text-ink-secondary whitespace-pre-wrap"><%= log.notes %></p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
