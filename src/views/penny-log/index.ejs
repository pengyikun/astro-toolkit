<%- include('../partials/header') %>

<%
  const statusTone = {
    success: 'success',
    pending: 'warning',
    failed: 'danger',
    timeout: 'neutral',
    returned: 'brand',
  };
%>

<section class="page-header">
  <div class="page-breadcrumbs">
    <span>Transactions</span>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
    </svg>
    <span>Ledger</span>
  </div>

  <div class="page-header-row">
    <div>
      <h1 class="console-title">Transaction ledger</h1>
    </div>
    <a href="/penny-log/new" class="console-button-primary">New Transaction</a>
  </div>
</section>

<form method="GET" action="/penny-log" class="console-toolbar list-filter-bar mt-6">
  <div class="flex flex-wrap items-center justify-end gap-4">
    <% if (filters.status || filters.direction || filters.partner_name || filters.date_from || filters.date_to || filters.search) { %>
      <a href="/penny-log" class="console-button-ghost !min-h-0 !px-0 text-sm font-semibold">Reset filters</a>
    <% } %>
  </div>

  <div class="list-filter-grid lg:grid-cols-3">
    <div>
      <label class="console-label" for="log-status">Status</label>
      <select id="log-status" name="status" class="console-select">
        <option value="">All statuses</option>
        <% ['pending', 'success', 'failed', 'timeout', 'returned'].forEach(s => { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="console-label" for="log-direction">Direction</label>
      <select id="log-direction" name="direction" class="console-select">
        <option value="">Inbound and outbound</option>
        <option value="inbound" <%= filters.direction === 'inbound' ? 'selected' : '' %>>Inbound</option>
        <option value="outbound" <%= filters.direction === 'outbound' ? 'selected' : '' %>>Outbound</option>
      </select>
    </div>
    <div>
      <label class="console-label" for="log-partner">Partner</label>
      <input type="text" id="log-partner" name="partner_name" value="<%= filters.partner_name || '' %>" placeholder="Partner name" class="console-input">
    </div>
    <div>
      <label class="console-label" for="log-from">From</label>
      <input type="date" id="log-from" name="date_from" value="<%= filters.date_from || '' %>" class="console-input">
    </div>
    <div>
      <label class="console-label" for="log-to">To</label>
      <input type="date" id="log-to" name="date_to" value="<%= filters.date_to || '' %>" class="console-input">
    </div>
    <div>
      <label class="console-label" for="log-search">Search</label>
      <input type="text" id="log-search" name="search" value="<%= filters.search || '' %>" placeholder="Reference, notes, partner" class="console-input">
    </div>
  </div>

  <div class="list-filter-actions">
    <button type="submit" class="console-button-secondary">Apply Filters</button>
    <a href="/penny-log" class="console-button-ghost">Clear</a>
  </div>
</form>

<% if (typeof data !== 'undefined' && data.length > 0) { %>
  <div class="record-stack lg:hidden mt-6">
    <% data.forEach(log => { %>
      <article class="record-card">
        <div class="record-card-header">
          <div>
            <div class="record-card-title" dir="auto"><%= log.partner_name %></div>
            <p class="record-card-copy">
              <%= log.direction %> / <span class="font-mono" dir="auto"><%= log.reference_id || 'no reference' %></span>
            </p>
          </div>
          <span class="signal-chip <%= statusTone[log.status] || 'neutral' %>"><%= log.status %></span>
        </div>
        <dl class="record-metadata">
          <div>
            <dt>Amount</dt>
            <dd class="font-mono"><%= log.amount %> <%= log.currency %></dd>
          </div>
          <div>
            <dt>Tested</dt>
            <dd><%= log.tested_at ? new Date(log.tested_at).toLocaleDateString() : '—' %></dd>
          </div>
        </dl>
        <div class="record-actions">
          <a href="/penny-log/<%= log.id %>" class="table-action-link">View</a>
          <a href="/penny-log/<%= log.id %>/edit" class="table-action-link">Edit</a>
          <button type="button" class="table-action-link danger" onclick="openConfirmModal('/penny-log/<%= log.id %>?_method=DELETE', 'Delete Transaction', 'Delete the <%= log.partner_name %> <%= log.direction %> transaction (<%= log.amount %> <%= log.currency %>)? This cannot be undone.')">Delete</button>
        </div>
      </article>
    <% }) %>
  </div>

  <div class="console-table-wrap hidden lg:block mt-6">
    <table class="console-table">
      <thead>
        <tr>
          <th>Status</th>
          <th>Date</th>
          <th>Partner</th>
          <th>Direction</th>
          <th>Amount</th>
          <th>Reference</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(log => { %>
          <tr>
            <td><span class="signal-chip <%= statusTone[log.status] || 'neutral' %>"><%= log.status %></span></td>
            <td><%= log.tested_at ? new Date(log.tested_at).toLocaleDateString() : '—' %></td>
            <td><span class="table-primary-link" dir="auto"><%= log.partner_name %></span><span class="table-secondary-copy"><%= log.currency %></span></td>
            <td><span class="font-semibold"><%= log.direction %></span></td>
            <td class="font-mono"><%= log.amount %></td>
            <td class="font-mono text-sm text-ink-secondary" dir="auto"><%= log.reference_id || '—' %></td>
            <td class="text-right">
              <div class="table-actions justify-end">
                <a href="/penny-log/<%= log.id %>" class="table-action-link">View</a>
                <a href="/penny-log/<%= log.id %>/edit" class="table-action-link">Edit</a>
                <button type="button" class="table-action-link danger" onclick="openConfirmModal('/penny-log/<%= log.id %>?_method=DELETE', 'Delete Transaction', 'Delete the <%= log.partner_name %> <%= log.direction %> transaction (<%= log.amount %> <%= log.currency %>)? This cannot be undone.')">Delete</button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <%- include('../partials/pagination') %>
  </div>
<% } else { %>
  <div class="console-table-wrap mt-6 lg:hidden">
    <div class="table-empty-card"><%= filters.status || filters.direction || filters.partner_name || filters.date_from || filters.date_to || filters.search ? 'No transactions found for the current filters.' : 'No transactions yet.' %></div>
  </div>

  <div class="console-table-wrap hidden lg:block mt-6">
    <table class="console-table">
      <thead>
        <tr>
          <th>Status</th>
          <th>Date</th>
          <th>Partner</th>
          <th>Direction</th>
          <th>Amount</th>
          <th>Reference</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <tr class="table-empty-row">
          <td colspan="7"><%= filters.status || filters.direction || filters.partner_name || filters.date_from || filters.date_to || filters.search ? 'No transactions found for the current filters.' : 'No transactions yet.' %></td>
        </tr>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
