<%- include('../partials/header') %>

<div class="flex items-center justify-between mb-6">
  <h2 class="text-xl font-semibold text-ink">Test Transactions</h2>
  <a href="/penny-log/new"
     class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium rounded-lg bg-brand text-white hover:bg-brand-dark transition-colors">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
    New Transaction
  </a>
</div>

<form method="GET" action="/penny-log" class="mb-5">
  <div class="flex flex-wrap gap-4 items-end">
    <!-- Transaction filters -->
    <div class="flex flex-wrap gap-3 items-end">
      <div>
        <label class="block text-[11px] font-medium text-ink-secondary uppercase tracking-wider mb-1.5">Status</label>
        <select name="status" class="block w-full sm:w-36 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
          <option value="">All</option>
          <% ['pending', 'success', 'failed', 'timeout', 'returned'].forEach(s => { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[11px] font-medium text-ink-secondary uppercase tracking-wider mb-1.5">Direction</label>
        <select name="direction" class="block w-full sm:w-36 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
          <option value="">All</option>
          <option value="inbound" <%= filters.direction === 'inbound' ? 'selected' : '' %>>Inbound</option>
          <option value="outbound" <%= filters.direction === 'outbound' ? 'selected' : '' %>>Outbound</option>
        </select>
      </div>
      <div>
        <label class="block text-[11px] font-medium text-ink-secondary uppercase tracking-wider mb-1.5">Partner</label>
        <input type="text" name="partner_name" value="<%= filters.partner_name || '' %>" placeholder="Partner name"
               class="block w-full sm:w-40 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
      </div>
    </div>

    <div class="w-px h-8 bg-border hidden lg:block"></div>

    <!-- Date range -->
    <div class="flex flex-wrap gap-3 items-end">
      <div>
        <label class="block text-[11px] font-medium text-ink-secondary uppercase tracking-wider mb-1.5">From</label>
        <input type="date" name="date_from" value="<%= filters.date_from || '' %>"
               class="block w-full sm:w-40 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
      </div>
      <div>
        <label class="block text-[11px] font-medium text-ink-secondary uppercase tracking-wider mb-1.5">To</label>
        <input type="date" name="date_to" value="<%= filters.date_to || '' %>"
               class="block w-full sm:w-40 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
      </div>
    </div>

    <div class="w-px h-8 bg-border hidden lg:block"></div>

    <!-- Search & actions -->
    <div class="flex flex-wrap gap-3 items-end">
      <div>
        <label class="block text-[11px] font-medium text-ink-secondary uppercase tracking-wider mb-1.5">Search</label>
        <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Reference, notes…"
               class="block w-full sm:w-48 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
      </div>
      <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-white text-ink border border-border hover:bg-page transition-colors">
        Filter
      </button>
      <a href="/penny-log" class="px-4 py-2 text-sm text-ink-secondary hover:text-ink">Clear</a>
    </div>
  </div>
</form>

<%
  const statusColors = {
    success: 'bg-success-light text-success',
    pending: 'bg-warning-light text-warning',
    failed: 'bg-danger-light text-danger',
    timeout: 'bg-page text-ink-secondary',
    returned: 'bg-brand-light text-brand',
  };
  const statusDotColors = {
    success: 'bg-success',
    pending: 'bg-warning',
    failed: 'bg-danger',
    timeout: 'bg-ink-muted',
    returned: 'bg-brand',
  };
%>

<% if (typeof data !== 'undefined' && data.length > 0) { %>
  <div class="bg-white rounded-xl border border-border overflow-hidden">
    <div class="overflow-x-auto">
    <table class="w-full text-sm min-w-[800px]">
      <thead>
        <tr class="border-b border-border">
          <th scope="col" class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Status</th>
          <th scope="col" class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Date</th>
          <th scope="col" class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Partner</th>
          <th scope="col" class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Direction</th>
          <th scope="col" class="text-right px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Amount</th>
          <th scope="col" class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Currency</th>
          <th scope="col" class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Reference ID</th>
          <th scope="col" class="text-right px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% data.forEach(log => { %>
          <tr class="hover:bg-page transition-colors">
            <td class="px-5 py-3.5">
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium <%= statusColors[log.status] || 'bg-page text-ink-secondary' %>">
                <span class="w-1.5 h-1.5 rounded-full <%= statusDotColors[log.status] || 'bg-ink-muted' %>"></span>
                <%= log.status.charAt(0).toUpperCase() + log.status.slice(1) %>
              </span>
            </td>
            <td class="px-5 py-3.5 text-ink-muted"><%= log.tested_at ? new Date(log.tested_at).toLocaleDateString() : '—' %></td>
            <td class="px-5 py-3.5 font-medium text-ink"><%= log.partner_name %></td>
            <td class="px-5 py-3.5">
              <span class="inline-flex items-center gap-1 text-xs font-medium
                <%= log.direction === 'inbound' ? 'text-[#4f46e5]' : 'text-success' %>">
                <% if (log.direction === 'inbound') { %>
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" /></svg>
                <% } else { %>
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" /></svg>
                <% } %>
                <%= log.direction %>
              </span>
            </td>
            <td class="px-5 py-3.5 text-right text-ink font-mono text-[13px]"><%= log.amount %></td>
            <td class="px-5 py-3.5 text-ink-muted"><%= log.currency %></td>
            <td class="px-5 py-3.5 text-ink-muted font-mono text-xs"><%= log.reference_id || '—' %></td>
            <td class="px-5 py-3.5 text-right">
              <div class="flex justify-end gap-1">
                <a href="/penny-log/<%= log.id %>" class="p-2 rounded-md text-ink-muted hover:text-brand hover:bg-page transition-colors" title="View" aria-label="View transaction">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                </a>
                <a href="/penny-log/<%= log.id %>/edit" class="p-2 rounded-md text-ink-muted hover:text-brand hover:bg-page transition-colors" title="Edit" aria-label="Edit transaction">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" /></svg>
                </a>
                <button type="button" onclick="openConfirmModal('/penny-log/<%= log.id %>?_method=DELETE', 'Delete Transaction', 'Delete the <%= log.partner_name %> <%= log.direction %> transaction (<%= log.amount %> <%= log.currency %>)? This cannot be undone.')"
                        class="p-2 rounded-md text-ink-muted hover:text-danger hover:bg-danger-light transition-colors" title="Delete" aria-label="Delete transaction">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>

    <%- include('../partials/pagination') %>
  </div>
<% } else { %>
  <div class="bg-white rounded-xl border border-border px-6 py-16 text-center">
    <div class="mx-auto w-10 h-10 rounded-full bg-page flex items-center justify-center mb-4">
      <svg class="w-5 h-5 text-ink-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
    </div>
    <p class="text-sm text-ink-muted mb-1">No test transactions found.</p>
    <p class="text-[12px] text-ink-muted mb-3">Record and monitor penny test payments to spot failures early.</p>
    <a href="/penny-log/new" class="text-sm text-brand hover:text-brand-dark font-medium">Record your first test transaction</a>
  </div>
<% } %>

<%- include('../partials/footer') %>
