<%- include('partials/header') %>

<div class="max-w-xl mx-auto mt-16 text-center">
  <div class="text-6xl font-bold text-gray-300 mb-4"><%= status %></div>
  <h2 class="text-xl font-semibold text-gray-900 mb-2"><%= message %></h2>
  <p class="text-sm text-gray-500 mb-8">Something went wrong. Please try again or go back to the dashboard.</p>
  <a href="/" class="inline-block px-5 py-2.5 text-sm font-medium rounded-lg bg-gray-900 text-white hover:bg-gray-800 transition-colors">
    ← Back to Dashboard
  </a>

  <% if (typeof stack !== 'undefined' && stack) { %>
    <div class="mt-10 text-left">
      <details class="bg-gray-900 rounded-xl p-4">
        <summary class="text-sm text-gray-400 cursor-pointer font-medium">Stack Trace</summary>
        <pre class="mt-3 text-xs text-gray-300 overflow-x-auto whitespace-pre-wrap"><%= stack %></pre>
      </details>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
