<%- include('partials/header') %>

<%
  const safeStatus = typeof status !== 'undefined'
    ? status
    : (typeof error !== 'undefined' && error && error.status ? error.status : 500);
  const safeMessage = typeof message !== 'undefined'
    ? message
    : (typeof error !== 'undefined' && error && error.message ? error.message : 'Internal Server Error');
%>

<div class="flex items-center justify-center" style="min-height: calc(100vh - 12rem);">
  <div class="text-center max-w-md">
    <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-5">
      <svg class="w-6 h-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
      </svg>
    </div>

    <p class="text-sm font-medium text-ink-muted mb-1"><%= safeStatus %></p>
    <h2 class="text-lg font-semibold text-ink mb-2"><%= safeMessage %></h2>
    <p class="text-sm text-ink-secondary mb-6">Something went wrong. Please try again or return to the dashboard.</p>

    <a href="/" class="console-button-primary">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
      Back to Dashboard
    </a>

    <% if (typeof stack !== 'undefined' && stack) { %>
      <div class="mt-8 text-left">
        <details class="console-table-wrap">
          <summary class="px-4 py-3 text-xs font-semibold text-ink-secondary uppercase tracking-wider cursor-pointer hover:bg-page transition-colors select-none">Stack Trace</summary>
          <div class="border-t border-border">
            <pre class="px-4 py-3 text-xs text-ink-secondary overflow-x-auto whitespace-pre-wrap bg-page/50 leading-relaxed"><%= stack %></pre>
          </div>
        </details>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
