<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>FinTech PM Toolkit</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="bg-page text-ink h-screen overflow-hidden flex">
  <!-- Mobile sidebar toggle -->
  <button id="sidebar-toggle" class="fixed top-3 left-3 z-50 p-2 rounded-lg bg-white border border-border shadow-sm lg:hidden" aria-label="Toggle navigation menu">
    <svg class="w-5 h-5 text-ink" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
  </button>
  <!-- Mobile backdrop -->
  <div id="sidebar-backdrop" class="fixed inset-0 bg-black/40 z-30 hidden lg:hidden"></div>

  <%- include('nav') %>
  <%- include('flash') %>
  <main class="flex-1 lg:ml-60 h-screen flex flex-col">
    <div class="flex-1 overflow-y-auto scroll-area bg-page">
      <div class="px-6 lg:px-10 py-8">
