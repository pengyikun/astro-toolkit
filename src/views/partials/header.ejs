<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>FinTech PM Toolkit</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<%
  const safeCurrentPath = typeof currentPath === 'string' ? currentPath : '';
  const safeNodeEnv = typeof nodeEnv === 'string' ? nodeEnv : 'development';
  const envTone = safeNodeEnv === 'production' ? 'danger' : 'warning';
%>
<body class="text-ink h-screen overflow-hidden flex bg-page">
  <button id="sidebar-toggle"
          class="fixed top-3 left-3 z-50 p-2.5 rounded-2xl bg-white border border-border lg:hidden"
          aria-label="Toggle navigation menu">
    <svg class="w-5 h-5 text-ink" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
    </svg>
  </button>
  <div id="sidebar-backdrop" class="fixed inset-0 bg-ink/45 z-30 hidden lg:hidden"></div>

  <%- include('nav') %>

  <main class="flex-1 lg:ml-72 h-screen flex flex-col">
    <div class="console-topbar">
      <div class="console-topbar-bar">
        <div class="console-topbar-actions">
          <div class="console-search-shell" data-global-search role="search" aria-label="Global toolkit search">
            <label class="console-search">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m1.6-5.15a6.75 6.75 0 1 1-13.5 0 6.75 6.75 0 0 1 13.5 0Z" />
              </svg>
              <input
                id="global-search-input"
                type="search"
                placeholder="Search accounts, vault labels, references"
                aria-label="Search toolkit records"
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-haspopup="listbox"
                aria-controls="global-search-results"
                aria-activedescendant=""
                aria-describedby="global-search-status"
                autocomplete="off"
                spellcheck="false"
                maxlength="120"
                enterkeyhint="search"
              >
            </label>
            <div id="global-search-status" class="sr-only" role="status" aria-live="polite"></div>
            <div
              id="global-search-results"
              class="console-search-results hidden"
              role="listbox"
              aria-label="Search results"
            ></div>
          </div>

          <span class="signal-chip <%= envTone %>">
            <span class="ops-chip-dot"></span>
            <%= safeNodeEnv.toUpperCase() %>
          </span>

          <div class="console-avatar" aria-hidden="true">PM</div>
        </div>
      </div>
    </div>

    <%- include('flash') %>

    <div class="flex-1 overflow-y-auto scroll-area">
      <div class="px-4 lg:px-8 py-6 lg:py-8">
