<%
  if (typeof totalPages !== 'undefined' && totalPages > 1) {
    const currentPage = typeof page !== 'undefined' ? page : 1;
    const buildUrl = (p) => {
      const params = new URLSearchParams(typeof filters !== 'undefined' ? filters : {});
      params.set('page', p);
      return '?' + params.toString();
    };
%>
  <nav class="sticky bottom-0 bg-white px-5 py-3 flex items-center justify-between border-t border-border">
    <p class="text-xs text-ink-secondary">
      Page <span class="font-medium text-ink"><%= currentPage %></span> of <span class="font-medium text-ink"><%= totalPages %></span>
      <% if (typeof total !== 'undefined') { %>
        — <span class="font-medium text-ink"><%= total %></span> records
      <% } %>
    </p>
    <div class="flex gap-1">
      <% if (currentPage > 1) { %>
        <a href="<%= buildUrl(currentPage - 1) %>"
           class="px-2.5 py-1 text-xs rounded-md border border-border bg-white hover:bg-page text-ink-secondary font-medium transition-colors">
          ← Prev
        </a>
      <% } %>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <% if (i === currentPage) { %>
          <span class="px-2.5 py-1 text-xs rounded-md bg-brand text-white font-medium"><%= i %></span>
        <% } else if (Math.abs(i - currentPage) <= 2 || i === 1 || i === totalPages) { %>
          <a href="<%= buildUrl(i) %>"
             class="px-2.5 py-1 text-xs rounded-md border border-border bg-white hover:bg-page text-ink-secondary transition-colors"><%= i %></a>
        <% } else if (Math.abs(i - currentPage) === 3) { %>
          <span class="px-1.5 py-1 text-xs text-ink-muted">…</span>
        <% } %>
      <% } %>
      <% if (currentPage < totalPages) { %>
        <a href="<%= buildUrl(currentPage + 1) %>"
           class="px-2.5 py-1 text-xs rounded-md border border-border bg-white hover:bg-page text-ink-secondary font-medium transition-colors">
          Next →
        </a>
      <% } %>
    </div>
  </nav>
<% } %>
