<%
  if (typeof totalPages !== 'undefined' && totalPages > 1) {
    const currentPage = typeof page !== 'undefined' ? page : 1;
    const buildUrl = (p) => {
      const params = new URLSearchParams(typeof filters !== 'undefined' ? filters : {});
      params.set('page', p);
      return '?' + params.toString();
    };
%>
  <nav class="px-4 py-4 border-t border-border/70 bg-white/50 backdrop-blur-md flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3" aria-label="Pagination">
    <p class="text-sm text-ink-secondary">
      Page <span class="font-semibold text-ink"><%= currentPage %></span> of <span class="font-semibold text-ink"><%= totalPages %></span>
      <% if (typeof total !== 'undefined') { %>
        <span class="text-ink-muted">/</span> <span class="font-semibold text-ink"><%= total %></span> records
      <% } %>
    </p>
    <div class="flex flex-wrap gap-2">
      <% if (currentPage > 1) { %>
        <a href="<%= buildUrl(currentPage - 1) %>" class="console-button-secondary !min-h-0 !px-3.5 !py-2 !text-xs" aria-label="Previous page">Previous</a>
      <% } %>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <% if (i === currentPage) { %>
          <span class="console-button-primary !min-h-0 !px-3.5 !py-2 !text-xs" aria-current="page"><%= i %></span>
        <% } else if (Math.abs(i - currentPage) <= 1 || i === 1 || i === totalPages) { %>
          <a href="<%= buildUrl(i) %>" class="console-button-secondary !min-h-0 !px-3.5 !py-2 !text-xs" aria-label="Page <%= i %>"><%= i %></a>
        <% } else if (Math.abs(i - currentPage) === 2) { %>
          <span class="inline-flex items-center px-1 text-ink-muted">…</span>
        <% } %>
      <% } %>
      <% if (currentPage < totalPages) { %>
        <a href="<%= buildUrl(currentPage + 1) %>" class="console-button-secondary !min-h-0 !px-3.5 !py-2 !text-xs" aria-label="Next page">Next</a>
      <% } %>
    </div>
  </nav>
<% } %>
