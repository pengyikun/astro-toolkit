<%
  const safeFlash = typeof flash !== 'undefined' && flash ? flash : {};
  const allToasts = [];
  if (safeFlash.success && safeFlash.success.length > 0) {
    safeFlash.success.forEach(msg => allToasts.push({ type: 'success', msg }));
  }
  if (safeFlash.error && safeFlash.error.length > 0) {
    safeFlash.error.forEach(msg => allToasts.push({ type: 'error', msg }));
  }
%>
<% allToasts.forEach((t, i) => { %>
  <div class="toast-enter fixed right-4 lg:right-8 z-50 px-4 py-3 rounded-[1.2rem] text-[13px] flex items-start gap-3 shadow-2xl border backdrop-blur-md
    <%= t.type === 'success' ? 'bg-success-light/90 border-success-border text-success' : 'bg-danger-light/92 border-danger-border text-danger' %>"
       style="min-width: 300px; top: <%= 92 + i * 72 %>px;"
       onanimationend="this.classList.contains('toast-dismiss') && this.remove()">
    <% if (t.type === 'success') { %>
      <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    <% } else { %>
      <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
      </svg>
    <% } %>
    <div class="flex-1">
      <div class="text-[11px] font-semibold uppercase tracking-[0.18em] opacity-70"><%= t.type === 'success' ? 'Update saved' : 'Needs attention' %></div>
      <p class="mt-1 text-[13px] leading-relaxed"><%= t.msg %></p>
    </div>
    <button onclick="this.parentElement.classList.replace('toast-enter','toast-dismiss')"
            class="mt-0.5 opacity-60 hover:opacity-100"
            aria-label="Dismiss message">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
<% }) %>
<script>
  document.querySelectorAll('.toast-enter').forEach(function (el) {
    setTimeout(function () {
      el.classList.replace('toast-enter', 'toast-dismiss');
    }, 5000);
  });
</script>
