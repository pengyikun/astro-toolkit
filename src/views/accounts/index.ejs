<%- include('../partials/header') %>

<section class="page-header">
  <div class="page-breadcrumbs">
    <span>Accounts</span>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
    </svg>
    <span>Registry</span>
  </div>

  <div class="page-header-row">
    <div>
      <h1 class="console-title">Account registry</h1>
    </div>
    <a href="/accounts/new" class="console-button-primary">Create Account</a>
  </div>
</section>

<form method="GET" action="/accounts" class="console-toolbar list-filter-bar mt-6">
  <div class="flex flex-wrap items-center justify-end gap-4">
    <% if (filters.region_code || filters.status || filters.account_type) { %>
      <a href="/accounts" class="console-button-ghost !min-h-0 !px-0 text-sm font-semibold">Reset filters</a>
    <% } %>
  </div>

  <div class="list-filter-grid lg:grid-cols-4">
    <div>
      <label class="console-label" for="filter-region">Region</label>
      <select id="filter-region" name="region_code" class="console-select">
        <option value="">All regions</option>
        <% if (typeof regions !== 'undefined') { regions.forEach(r => { %>
          <option value="<%= r.code %>" <%= filters.region_code === r.code ? 'selected' : '' %>><%= r.name %></option>
        <% }) } %>
      </select>
    </div>
    <div>
      <label class="console-label" for="filter-status">Status</label>
      <select id="filter-status" name="status" class="console-select">
        <option value="">All statuses</option>
        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="archived" <%= filters.status === 'archived' ? 'selected' : '' %>>Archived</option>
      </select>
    </div>
    <div>
      <label class="console-label" for="filter-type">Account Type</label>
      <select id="filter-type" name="account_type" class="console-select">
        <option value="">Mock and real</option>
        <option value="mock" <%= filters.account_type === 'mock' ? 'selected' : '' %>>Mock</option>
        <option value="real" <%= filters.account_type === 'real' ? 'selected' : '' %>>Real</option>
      </select>
    </div>
    <div class="list-filter-actions">
      <button type="submit" class="console-button-secondary w-full lg:w-auto">Apply Filters</button>
    </div>
  </div>
</form>

<% if (typeof data !== 'undefined' && data.length > 0) { %>
  <div class="record-stack lg:hidden mt-6">
    <% data.forEach(account => { %>
      <article class="record-card">
        <div class="record-card-header">
          <div>
            <a href="/accounts/<%= account.id %>" class="record-card-title hover:text-brand" dir="auto"><%= account.name %></a>
            <p class="record-card-copy"><%= account.region_code %> / <span class="font-mono"><%= account.currency %></span></p>
          </div>
          <span class="signal-chip <%= account.status === 'active' ? 'success' : 'neutral' %>"><%= account.status %></span>
        </div>
        <dl class="record-metadata">
          <div>
            <dt>Account type</dt>
            <dd><%= account.account_type %></dd>
          </div>
          <div>
            <dt>Created</dt>
            <dd><%= new Date(account.created_at).toLocaleDateString() %></dd>
          </div>
        </dl>
        <div class="record-actions">
          <a href="/accounts/<%= account.id %>" class="table-action-link">View</a>
          <a href="/accounts/<%= account.id %>/edit" class="table-action-link">Edit</a>
          <button type="button" class="table-action-link danger" onclick="openConfirmModal('/accounts/<%= account.id %>?_method=DELETE', 'Archive Account', 'Archive &quot;<%= account.name %>&quot;? It can be restored later.')">Archive</button>
        </div>
      </article>
    <% }) %>
  </div>

  <div class="console-table-wrap hidden lg:block mt-6">
    <table class="console-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Region</th>
          <th>Type</th>
          <th>Status</th>
          <th>Created</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(account => { %>
          <tr>
            <td>
              <a href="/accounts/<%= account.id %>" class="table-primary-link hover:text-brand" dir="auto"><%= account.name %></a>
              <span class="table-secondary-copy font-mono"><%= account.currency %></span>
            </td>
            <td><span class="font-semibold"><%= account.region_code %></span></td>
            <td><span class="signal-chip <%= account.account_type === 'mock' ? 'brand' : 'warning' %>"><%= account.account_type %></span></td>
            <td><span class="signal-chip <%= account.status === 'active' ? 'success' : 'neutral' %>"><%= account.status %></span></td>
            <td><%= new Date(account.created_at).toLocaleDateString() %></td>
            <td class="text-right">
              <div class="table-actions justify-end">
                <a href="/accounts/<%= account.id %>" class="table-action-link">View</a>
                <a href="/accounts/<%= account.id %>/edit" class="table-action-link">Edit</a>
                <button type="button" class="table-action-link danger" onclick="openConfirmModal('/accounts/<%= account.id %>?_method=DELETE', 'Archive Account', 'Archive &quot;<%= account.name %>&quot;? It can be restored later.')">Archive</button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <%- include('../partials/pagination') %>
  </div>
<% } else { %>
  <div class="console-table-wrap mt-6 lg:hidden">
    <div class="table-empty-card"><%= filters.region_code || filters.status || filters.account_type ? 'No accounts found for the current filters.' : 'No accounts yet.' %></div>
  </div>

  <div class="console-table-wrap hidden lg:block mt-6">
    <table class="console-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Region</th>
          <th>Type</th>
          <th>Status</th>
          <th>Created</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <tr class="table-empty-row">
          <td colspan="6"><%= filters.region_code || filters.status || filters.account_type ? 'No accounts found for the current filters.' : 'No accounts yet.' %></td>
        </tr>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
