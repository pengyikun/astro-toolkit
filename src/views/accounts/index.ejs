<%- include('../partials/header') %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-semibold text-ink">Accounts</h2>
    <p class="text-[13px] text-ink-secondary mt-1">Manage test bank accounts across regions</p>
  </div>
  <a href="/accounts/new"
     class="inline-flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium rounded-lg bg-brand text-white hover:bg-brand-dark transition-colors">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
    New Account
  </a>
</div>

<form method="GET" action="/accounts" class="flex flex-wrap items-center gap-3 mb-5">
  <select name="region_code" class="rounded-lg border border-border bg-white px-3 py-2 text-[13px] text-ink-secondary focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
    <option value="">All Regions</option>
    <% if (typeof regions !== 'undefined') { regions.forEach(r => { %>
      <option value="<%= r.code %>" <%= (filters.region_code === r.code) ? 'selected' : '' %>><%= r.name %></option>
    <% }) } %>
  </select>
  <select name="status" class="rounded-lg border border-border bg-white px-3 py-2 text-[13px] text-ink-secondary focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
    <option value="">All Status</option>
    <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
    <option value="archived" <%= filters.status === 'archived' ? 'selected' : '' %>>Archived</option>
  </select>
  <select name="account_type" class="rounded-lg border border-border bg-white px-3 py-2 text-[13px] text-ink-secondary focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
    <option value="">All Types</option>
    <option value="mock" <%= filters.account_type === 'mock' ? 'selected' : '' %>>Mock</option>
    <option value="real" <%= filters.account_type === 'real' ? 'selected' : '' %>>Real</option>
  </select>
  <button type="submit" class="px-3.5 py-2 text-[13px] font-medium rounded-lg bg-white text-ink border border-border hover:bg-page transition-colors">
    Apply
  </button>
  <% if (filters.region_code || filters.status || filters.account_type) { %>
    <a href="/accounts" class="text-[13px] text-ink-muted hover:text-ink transition-colors">Clear filters</a>
  <% } %>
</form>

<div class="bg-white rounded-xl border border-border overflow-hidden">
  <% if (typeof data !== 'undefined' && data.length > 0) { %>
    <table class="w-full text-[13px]">
      <thead>
        <tr class="border-b border-border">
          <th class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-muted">Name</th>
          <th class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-muted">Region</th>
          <th class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-muted">Currency</th>
          <th class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-muted">Type</th>
          <th class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-muted">Status</th>
          <th class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-muted">Created</th>
          <th class="w-24 px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% data.forEach(account => { %>
          <tr class="hover:bg-page/60 transition-colors group">
            <td class="px-5 py-3 font-medium text-ink">
              <a href="/accounts/<%= account.id %>" class="hover:text-brand transition-colors"><%= account.name %></a>
            </td>
            <td class="px-5 py-3 text-ink-secondary"><%= account.region_code %></td>
            <td class="px-5 py-3 text-ink-secondary font-mono"><%= account.currency %></td>
            <td class="px-5 py-3">
              <span class="inline-flex items-center gap-1.5 text-xs font-medium
                <%= account.account_type === 'mock' ? 'text-brand' : 'text-[#c77d0a]' %>">
                <span class="w-1.5 h-1.5 rounded-full <%= account.account_type === 'mock' ? 'bg-brand' : 'bg-[#c77d0a]' %>"></span>
                <%= account.account_type %>
              </span>
            </td>
            <td class="px-5 py-3">
              <span class="inline-flex items-center gap-1.5 text-xs font-medium
                <%= account.status === 'active' ? 'text-[#0d7d4d]' : 'text-ink-muted' %>">
                <span class="w-1.5 h-1.5 rounded-full <%= account.status === 'active' ? 'bg-[#0d7d4d]' : 'bg-ink-muted' %>"></span>
                <%= account.status %>
              </span>
            </td>
            <td class="px-5 py-3 text-ink-secondary"><%= new Date(account.created_at).toLocaleDateString() %></td>
            <td class="px-5 py-3">
              <div class="flex justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                <a href="/accounts/<%= account.id %>" class="p-1.5 rounded-md text-ink-muted hover:text-brand hover:bg-brand/5 transition-colors" title="View">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                </a>
                <a href="/accounts/<%= account.id %>/edit" class="p-1.5 rounded-md text-ink-muted hover:text-brand hover:bg-brand/5 transition-colors" title="Edit">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" /></svg>
                </a>
                <button type="button" onclick="openConfirmModal('/accounts/<%= account.id %>?_method=DELETE', 'Delete Account', 'Are you sure you want to archive this account?')"
                        class="p-1.5 rounded-md text-ink-muted hover:text-[#cd3d64] hover:bg-[#fce4ec] transition-colors" title="Delete">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <%- include('../partials/pagination') %>
  <% } else { %>
    <div class="px-6 py-16 text-center">
      <div class="mx-auto w-10 h-10 rounded-full bg-page flex items-center justify-center mb-4">
        <svg class="w-5 h-5 text-ink-muted/60" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" /></svg>
      </div>
      <p class="text-sm text-ink-secondary mb-3">No accounts found</p>
      <a href="/accounts/new" class="text-sm text-brand hover:text-brand-dark font-medium">Create your first account &rarr;</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
