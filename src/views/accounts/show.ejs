<%- include('../partials/header') %>

<div class="max-w-3xl">
  <div class="mb-6">
    <a href="/accounts" class="text-sm text-gray-500 hover:text-gray-700">← Back to Accounts</a>
  </div>

  <div class="flex items-start justify-between mb-6">
    <div>
      <h2 class="text-2xl font-semibold text-gray-900"><%= account.name %></h2>
      <div class="flex items-center gap-2 mt-2">
        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium
          <%= account.account_type === 'mock' ? 'bg-purple-100 text-purple-700' : 'bg-orange-100 text-orange-700' %>">
          <%= account.account_type %>
        </span>
        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium
          <%= account.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
          <%= account.status %>
        </span>
      </div>
    </div>
    <div class="flex gap-2">
      <a href="/accounts/<%= account.id %>/edit"
         class="px-4 py-2 text-sm font-medium rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors">
        Edit
      </a>
      <button type="button"
              onclick="openConfirmModal('/accounts/<%= account.id %>?_method=DELETE', 'Delete Account', 'Are you sure you want to archive this account?')"
              class="px-4 py-2 text-sm font-medium rounded-lg bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 transition-colors">
        Delete
      </button>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Account Details</h3>
    <dl class="grid grid-cols-2 gap-x-8 gap-y-4">
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Region</dt>
        <dd class="text-sm text-gray-900 mt-0.5"><%= account.region_code %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Currency</dt>
        <dd class="text-sm text-gray-900 mt-0.5"><%= account.currency %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Created</dt>
        <dd class="text-sm text-gray-900 mt-0.5"><%= new Date(account.created_at).toLocaleString() %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Updated</dt>
        <dd class="text-sm text-gray-900 mt-0.5"><%= new Date(account.updated_at).toLocaleString() %></dd>
      </div>
    </dl>
  </div>

  <% if (account.fields && account.fields.length > 0) { %>
    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Region Fields</h3>
      <dl class="grid grid-cols-2 gap-x-8 gap-y-4">
        <% account.fields.filter(f => !f.is_custom).forEach(f => { %>
          <div>
            <dt class="text-xs font-medium text-gray-400 uppercase"><%= f.field_label %></dt>
            <dd class="text-sm text-gray-900 mt-0.5">
              <% if (f.field_value) { %>
                <% if (f.field_type === 'textarea') { %>
                  <pre class="whitespace-pre-wrap font-sans"><%= f.field_value %></pre>
                <% } else { %>
                  <%= f.field_value %>
                <% } %>
              <% } else { %>
                <span class="text-gray-300">—</span>
              <% } %>
            </dd>
          </div>
        <% }) %>
      </dl>
    </div>

    <% const customFields = account.fields.filter(f => f.is_custom); %>
    <% if (customFields.length > 0) { %>
      <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Custom Fields</h3>
        <dl class="grid grid-cols-2 gap-x-8 gap-y-4">
          <% customFields.forEach(f => { %>
            <div>
              <dt class="text-xs font-medium text-gray-400 uppercase"><%= f.field_label %></dt>
              <dd class="text-sm text-gray-900 mt-0.5"><%= f.field_value || '—' %></dd>
            </div>
          <% }) %>
        </dl>
      </div>
    <% } %>
  <% } %>

  <% if (account.notes) { %>
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Notes</h3>
      <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= account.notes %></p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
