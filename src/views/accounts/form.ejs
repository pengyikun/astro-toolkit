<%- include('../partials/header') %>

<%
  const isEdit = account && account.id;
  const formAction = isEdit ? `/accounts/${account.id}?_method=PUT` : '/accounts';
  const transferType = account ? (account.transfer_type || 'domestic') : 'domestic';
  const hasBankAddress = account && (account.generic_bank_street || account.generic_bank_city || account.generic_bank_state || account.generic_bank_postal || account.generic_bank_country);
  const customFields = isEdit && account.fields ? account.fields.filter(f => f.is_custom) : [];
%>

<section class="page-header">
  <div class="page-breadcrumbs">
    <a href="/accounts" class="font-medium hover:text-ink">Accounts</a>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
    </svg>
    <span><%= isEdit ? 'Edit' : 'New' %></span>
  </div>

  <div class="page-header-row">
    <div class="max-w-2xl">
      <h1 class="console-title"><%= isEdit ? 'Edit account' : 'New account' %></h1>
    </div>
    <div class="signal-chip <%= transferType === 'international' ? 'brand' : 'neutral' %>">
      <span class="ops-chip-dot"></span>
      <%= transferType === 'international' ? 'International rail' : 'Domestic rail' %>
    </div>
  </div>
</section>

<% if (errors) { %>
  <div class="console-panel mt-6 p-5 border-danger-border bg-danger-light/70">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-danger mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
      </svg>
      <div>
        <div class="console-kicker text-danger/75">Please fix before saving</div>
        <ul class="mt-3 list-disc list-inside text-sm leading-relaxed text-danger">
          <% errors.forEach(err => { %>
            <li><%= err.field ? err.field + ': ' : '' %><%= err.message %></li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
<% } %>

<form method="POST" action="<%= formAction %>" id="account-form" class="mt-6 step-layout">
  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

  <aside class="step-rail">
    <div class="console-panel p-4">
      <div class="console-kicker">Progress</div>
      <div class="mt-4 grid gap-3">
        <button type="button" class="step-button is-active" data-step-target="1">
          <span class="step-index">1</span>
          <span>
            <span class="step-title">Setup</span>
          </span>
        </button>
        <button type="button" class="step-button" data-step-target="2">
          <span class="step-index">2</span>
          <span>
            <span class="step-title">Routing</span>
          </span>
        </button>
        <button type="button" class="step-button" data-step-target="3">
          <span class="step-index">3</span>
          <span>
            <span class="step-title">Extras</span>
          </span>
        </button>
        <button type="button" class="step-button" data-step-target="4">
          <span class="step-index">4</span>
          <span>
            <span class="step-title">Review</span>
          </span>
        </button>
      </div>
    </div>

    <div class="console-panel p-5">
      <div class="console-kicker">Live Summary</div>
      <div class="step-summary mt-4">
        <div class="step-summary-row">
          <div class="step-summary-label">Account</div>
          <div class="step-summary-value" data-summary="name"><%= account ? account.name || 'Unassigned' : 'Unassigned' %></div>
        </div>
        <div class="step-summary-row">
          <div class="step-summary-label">Region</div>
          <div class="step-summary-value" data-summary="region"><%= account ? account.region_code || 'Select region' : 'Select region' %></div>
        </div>
        <div class="step-summary-row">
          <div class="step-summary-label">Currency</div>
          <div class="step-summary-value font-mono" data-summary="currency"><%= account ? account.currency || '---' : '---' %></div>
        </div>
        <div class="step-summary-row">
          <div class="step-summary-label">Account Type</div>
          <div class="step-summary-value" data-summary="type"><%= account ? account.account_type || 'Choose type' : 'Choose type' %></div>
        </div>
        <div class="step-summary-row">
          <div class="step-summary-label">Rail</div>
          <div class="step-summary-value" data-summary="transfer"><%= transferType %></div>
        </div>
      </div>
      <a href="/accounts" class="console-button-secondary w-full mt-5">Cancel</a>
    </div>
  </aside>

  <div class="grid gap-6">
    <section class="step-panel is-active" data-step-panel="1">
      <div class="step-frame">
        <div class="step-frame-head">
          <div class="console-kicker">Step 1</div>
          <h2 class="console-section-title mt-3">Account setup</h2>
        </div>
        <div class="step-frame-body">
          <div class="grid gap-5 lg:grid-cols-2">
            <div class="lg:col-span-2">
              <label for="name" class="console-label">Account Name</label>
              <input type="text" id="name" name="name" required value="<%= account ? account.name || '' : '' %>" placeholder="e.g. Brazil PIX Test Acct #1" class="console-input">
            </div>

            <div class="lg:col-span-2">
              <label class="console-label">Country / Region</label>
              <div class="relative" id="region-dropdown-wrapper">
                <input type="text" id="region-search" autocomplete="off"
                       placeholder="Search by country, code, or currency"
                       value="<%= account && account.region_code ? regions.find(r => r.code === account.region_code)?.name + ' (' + account.region_code + ')' : '' %>"
                       class="console-input pr-12">
                <input type="hidden" id="region_code" name="region_code" required value="<%= account ? account.region_code || '' : '' %>">
                <svg class="absolute right-4 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-muted pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
                <div id="region-dropdown" class="hidden absolute z-30 top-full left-0 right-0 mt-2 console-panel overflow-hidden max-h-72 overflow-y-auto">
                  <% regions.forEach(r => { %>
                    <div class="region-option px-4 py-3 cursor-pointer hover:bg-brand-light/70 transition-colors"
                         data-code="<%= r.code %>" data-name="<%= r.name %>" data-currency="<%= r.currency %>">
                      <div class="text-sm font-semibold text-ink"><%= r.name %> <span class="text-ink-muted">(<%= r.code %>)</span></div>
                      <div class="mt-1 text-xs text-ink-secondary">Settlement currency <span class="font-mono"><%= r.currency %></span></div>
                    </div>
                  <% }) %>
                  <div id="region-no-match" class="hidden px-4 py-4 text-sm text-ink-muted text-center">No matching regions</div>
                </div>
              </div>
            </div>

            <div>
              <label for="currency" class="console-label">Currency</label>
              <input type="text" id="currency" name="currency" required readonly value="<%= account ? account.currency || '' : '' %>" placeholder="Selected from region" class="console-input font-mono">
            </div>

            <div>
              <label class="console-label">Account Type</label>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="record-card cursor-pointer">
                  <input type="radio" name="account_type" value="mock" required <%= (!account || account.account_type === 'mock') ? 'checked' : '' %> class="sr-only account-type-radio">
                  <span class="record-card-title">Mock</span>
                </label>
                <label class="record-card cursor-pointer">
                  <input type="radio" name="account_type" value="real" required <%= (account && account.account_type === 'real') ? 'checked' : '' %> class="sr-only account-type-radio">
                  <span class="record-card-title">Real</span>
                </label>
              </div>
            </div>

            <div class="lg:col-span-2">
              <label class="console-label">Transfer Rail</label>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="record-card cursor-pointer">
                  <input type="radio" name="transfer_type" value="domestic" required class="sr-only transfer-type-radio" <%= transferType === 'domestic' ? 'checked' : '' %>>
                  <span class="record-card-title">Domestic</span>
                </label>
                <label class="record-card cursor-pointer">
                  <input type="radio" name="transfer_type" value="international" required class="sr-only transfer-type-radio" <%= transferType === 'international' ? 'checked' : '' %>>
                  <span class="record-card-title">International</span>
                </label>
              </div>
            </div>
          </div>

          <div class="step-nav">
            <span></span>
            <button type="button" class="console-button-primary" data-next-step="2">Continue to routing</button>
          </div>
        </div>
      </div>
    </section>

    <section class="step-panel" data-step-panel="2">
      <div class="step-frame">
        <div class="step-frame-head">
          <div class="console-kicker">Step 2</div>
          <h2 class="console-section-title mt-3">Routing details</h2>
        </div>
        <div class="step-frame-body">
          <div class="grid gap-5">
            <div class="console-panel p-5">
              <div class="console-kicker">Account holder and bank</div>
              <div class="grid gap-5 lg:grid-cols-2 mt-4">
                <div>
                  <label for="generic_account_holder" class="console-label">Account Holder Name</label>
                  <input type="text" id="generic_account_holder" name="generic_account_holder" value="<%= account ? account.generic_account_holder || '' : '' %>" placeholder="Full legal name" class="console-input">
                </div>
                <div>
                  <label for="generic_bank_name" class="console-label">Bank Name</label>
                  <input type="text" id="generic_bank_name" name="generic_bank_name" value="<%= account ? account.generic_bank_name || '' : '' %>" placeholder="e.g. NatWest Bank" class="console-input">
                </div>
                <div class="lg:col-span-2">
                  <label for="generic_account_number" class="console-label">Primary Account Number</label>
                  <input type="text" id="generic_account_number" name="generic_account_number" value="<%= account ? account.generic_account_number || '' : '' %>" placeholder="Core bank account number" class="console-input font-mono">
                </div>
              </div>
            </div>

            <div id="international-fields" class="console-panel p-5 <%= transferType !== 'international' ? 'hidden' : '' %>">
              <div class="console-kicker">International wire details</div>
              <div class="grid gap-5 lg:grid-cols-2 mt-4">
                <div>
                  <label for="generic_iban" class="console-label">IBAN</label>
                  <input type="text" id="generic_iban" name="generic_iban" value="<%= account ? account.generic_iban || '' : '' %>" placeholder="e.g. GB29NWBK60161331926819" class="console-input font-mono">
                </div>
                <div>
                  <label for="generic_swift_bic" class="console-label">SWIFT / BIC</label>
                  <input type="text" id="generic_swift_bic" name="generic_swift_bic" value="<%= account ? account.generic_swift_bic || '' : '' %>" placeholder="e.g. NWBKGB2L" class="console-input font-mono">
                </div>
                <div>
                  <label for="generic_intermediary_bank" class="console-label">Intermediary Bank</label>
                  <input type="text" id="generic_intermediary_bank" name="generic_intermediary_bank" value="<%= account ? account.generic_intermediary_bank || '' : '' %>" placeholder="Only if a correspondent bank is required" class="console-input">
                </div>
                <div>
                  <label for="generic_intermediary_swift" class="console-label">Intermediary SWIFT</label>
                  <input type="text" id="generic_intermediary_swift" name="generic_intermediary_swift" value="<%= account ? account.generic_intermediary_swift || '' : '' %>" placeholder="Intermediary bank SWIFT/BIC" class="console-input font-mono">
                </div>
              </div>
            </div>

            <div id="domestic-fields">
              <div id="region-fields-container" class="console-panel p-5 <%= (!account || !account.region_code || transferType === 'international') ? 'hidden' : '' %>">
                <div class="console-kicker">Local banking details</div>
                <div class="mt-2 text-sm text-ink-secondary">Fields loaded for <span id="region-fields-title" class="font-semibold text-ink"><%= account && account.region_code ? account.region_code : '' %></span>.</div>
                <div id="region-fields" class="grid gap-5 mt-4">
                  <% if (isEdit && account.fields && account.fields.length > 0) { %>
                    <% account.fields.filter(f => !f.is_custom && !f.field_key.startsWith('generic_')).forEach((f) => { %>
                      <div>
                        <label class="console-label"><%= f.field_label %><% if (f.required) { %> <span class="text-danger">*</span><% } %></label>
                        <input type="hidden" name="field_key[]" value="<%= f.field_key %>">
                        <input type="hidden" name="field_label[]" value="<%= f.field_label %>">
                        <input type="hidden" name="field_type[]" value="<%= f.field_type || 'text' %>">
                        <input type="hidden" name="field_is_custom[]" value="0">
                        <% if (f.field_type === 'textarea') { %>
                          <textarea name="field_value[]" rows="3" class="console-textarea"><%= f.field_value || '' %></textarea>
                        <% } else if (f.field_type === 'select' && f.options) { %>
                          <select name="field_value[]" class="console-select">
                            <option value="">Select...</option>
                            <% f.options.forEach(opt => { %>
                              <option value="<%= opt %>" <%= f.field_value === opt ? 'selected' : '' %>><%= opt %></option>
                            <% }) %>
                          </select>
                        <% } else { %>
                          <input type="text" name="field_value[]" value="<%= f.field_value || '' %>" placeholder="<%= f.placeholder || '' %>" class="console-input">
                        <% } %>
                      </div>
                    <% }) %>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <div class="step-nav">
            <button type="button" class="console-button-secondary" data-prev-step="1">Back</button>
            <button type="button" class="console-button-primary" data-next-step="3">Continue to extras</button>
          </div>
        </div>
      </div>
    </section>

    <section class="step-panel" data-step-panel="3">
      <div class="step-frame">
        <div class="step-frame-head">
          <div class="console-kicker">Step 3</div>
          <h2 class="console-section-title mt-3">Optional details</h2>
        </div>
        <div class="step-frame-body">
          <div class="grid gap-5">
            <div class="console-panel p-5">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <div class="console-kicker">Bank address</div>
                </div>
                <span class="signal-chip <%= hasBankAddress ? 'brand' : 'neutral' %>"><%= hasBankAddress ? 'Pre-filled' : 'Optional' %></span>
              </div>

              <div class="grid gap-5 lg:grid-cols-2 mt-5">
                <div class="lg:col-span-2">
                  <label for="generic_bank_street" class="console-label">Street Address</label>
                  <input type="text" id="generic_bank_street" name="generic_bank_street" value="<%= account ? account.generic_bank_street || '' : '' %>" placeholder="Street name and number" class="console-input">
                </div>
                <div>
                  <label for="generic_bank_city" class="console-label">City</label>
                  <input type="text" id="generic_bank_city" name="generic_bank_city" value="<%= account ? account.generic_bank_city || '' : '' %>" placeholder="City" class="console-input">
                </div>
                <div>
                  <label for="generic_bank_state" class="console-label">State / Province</label>
                  <input type="text" id="generic_bank_state" name="generic_bank_state" value="<%= account ? account.generic_bank_state || '' : '' %>" placeholder="State or province" class="console-input">
                </div>
                <div>
                  <label for="generic_bank_postal" class="console-label">Postal / ZIP Code</label>
                  <input type="text" id="generic_bank_postal" name="generic_bank_postal" value="<%= account ? account.generic_bank_postal || '' : '' %>" placeholder="Postal code" class="console-input">
                </div>
                <div>
                  <label for="generic_bank_country" class="console-label">Country</label>
                  <input type="text" id="generic_bank_country" name="generic_bank_country" value="<%= account ? account.generic_bank_country || '' : '' %>" placeholder="Country" class="console-input">
                </div>
              </div>
            </div>

            <div class="console-panel p-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="console-kicker">Custom fields</div>
                </div>
                <button type="button" id="add-custom-field" class="console-button-secondary !min-h-0 !px-4 !py-2 text-sm">Add Field</button>
              </div>

              <div id="custom-fields" class="grid gap-3 mt-5">
                <% if (customFields.length > 0) { %>
                  <% customFields.forEach((f) => { %>
                    <div class="custom-field-row grid gap-3 lg:grid-cols-[1fr_1fr_1.3fr_auto]">
                      <input type="text" name="field_key[]" value="<%= f.field_key %>" placeholder="field_key" class="console-input font-mono">
                      <input type="text" name="field_label[]" value="<%= f.field_label %>" placeholder="Display label" class="console-input">
                      <input type="text" name="field_value[]" value="<%= f.field_value || '' %>" placeholder="Stored value" class="console-input">
                      <input type="hidden" name="field_type[]" value="text">
                      <input type="hidden" name="field_is_custom[]" value="1">
                      <button type="button" class="console-button-danger !min-h-0 !px-4 !py-2 custom-field-remove">Remove</button>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="console-empty" id="custom-fields-empty">
                    <div class="console-empty-icon">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                      </svg>
                  </div>
                  <div>
                    <h3>No custom fields yet</h3>
                  </div>
                </div>
              <% } %>
              </div>
            </div>
          </div>

          <div class="step-nav">
            <button type="button" class="console-button-secondary" data-prev-step="2">Back</button>
            <button type="button" class="console-button-primary" data-next-step="4">Review account</button>
          </div>
        </div>
      </div>
    </section>

    <section class="step-panel" data-step-panel="4">
      <div class="step-frame">
        <div class="step-frame-head">
          <div class="console-kicker">Step 4</div>
          <h2 class="console-section-title mt-3">Review and save</h2>
        </div>
        <div class="step-frame-body">
          <div class="grid gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(280px,0.9fr)]">
            <div class="console-panel p-5">
              <div class="console-kicker">Operator notes</div>
              <label for="notes" class="console-label mt-4">Notes for handoff</label>
              <textarea id="notes" name="notes" rows="6" placeholder="What should the next PM or operator know about this account?" class="console-textarea"><%= account ? account.notes || '' : '' %></textarea>
            </div>

            <div class="console-panel p-5">
              <div class="console-kicker">Review snapshot</div>
              <dl class="step-review-list mt-4">
                <div class="step-review-item">
                  <dt>Account name</dt>
                  <dd data-summary="name"><%= account ? account.name || 'Unassigned' : 'Unassigned' %></dd>
                </div>
                <div class="step-review-item">
                  <dt>Region and currency</dt>
                  <dd><span data-summary="region"><%= account ? account.region_code || 'Select region' : 'Select region' %></span> / <span data-summary="currency"><%= account ? account.currency || '---' : '---' %></span></dd>
                </div>
                <div class="step-review-item">
                  <dt>Operating mode</dt>
                  <dd><span data-summary="type"><%= account ? account.account_type || 'Choose type' : 'Choose type' %></span> / <span data-summary="transfer"><%= transferType %></span></dd>
                </div>
              </dl>
            </div>
          </div>

          <div class="step-nav">
            <button type="button" class="console-button-secondary" data-prev-step="3">Back</button>
            <button type="submit" class="console-button-primary"><%= isEdit ? 'Update Account' : 'Create Account' %></button>
          </div>
        </div>
      </div>
    </section>
  </div>
</form>

<script src="/js/region-fields.js"></script>

<%- include('../partials/footer') %>
