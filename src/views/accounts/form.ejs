<%- include('../partials/header') %>

<%
  const isEdit = account && account.id;
  const formAction = isEdit ? `/accounts/${account.id}?_method=PUT` : '/accounts';
%>

<div class="max-w-3xl">
  <div class="mb-6">
    <a href="/accounts" class="text-sm text-gray-500 hover:text-gray-700">← Back to Accounts</a>
  </div>

  <h2 class="text-2xl font-semibold text-gray-900 mb-6"><%= isEdit ? 'Edit Account' : 'Create Account' %></h2>

  <% if (errors) { %>
    <div class="mb-6 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm">
      <p class="font-medium mb-1">Please fix the following errors:</p>
      <ul class="list-disc list-inside">
        <% errors.forEach(err => { %>
          <li><%= err.field ? err.field + ': ' : '' %><%= err.message %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= formAction %>" class="space-y-6">
    <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-5">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Basic Information</h3>

      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
          Name <span class="text-red-500">*</span>
        </label>
        <input type="text" id="name" name="name" required
               value="<%= account ? account.name || '' : '' %>"
               placeholder="e.g. Brazil PIX Test Acct #1"
               class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Account Type <span class="text-red-500">*</span>
        </label>
        <div class="flex gap-6">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="account_type" value="mock" required
                   <%= (!account || account.account_type === 'mock') ? 'checked' : '' %>
                   class="text-blue-600 focus:ring-blue-500">
            <span class="text-sm text-gray-700">Mock</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="account_type" value="real" required
                   <%= (account && account.account_type === 'real') ? 'checked' : '' %>
                   class="text-blue-600 focus:ring-blue-500">
            <span class="text-sm text-gray-700">Real</span>
          </label>
        </div>
      </div>

      <div>
        <label for="region_code" class="block text-sm font-medium text-gray-700 mb-1">
          Region <span class="text-red-500">*</span>
        </label>
        <select id="region_code" name="region_code" required
                class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          <option value="">Select a region…</option>
          <% regions.forEach(r => { %>
            <option value="<%= r.code %>"
                    data-currency="<%= r.currency %>"
                    <%= (account && account.region_code === r.code) ? 'selected' : '' %>>
              <%= r.name %> (<%= r.code %>)
            </option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="currency" class="block text-sm font-medium text-gray-700 mb-1">
          Currency <span class="text-red-500">*</span>
        </label>
        <input type="text" id="currency" name="currency" required
               value="<%= account ? account.currency || '' : '' %>"
               placeholder="Auto-filled from region"
               class="block w-40 rounded-lg border border-gray-300 px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
    </div>

    <div id="region-fields-container" class="bg-white rounded-xl border border-gray-200 p-6 space-y-5 <%= (!account || !account.region_code) ? 'hidden' : '' %>">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">
        Region Details — <span id="region-fields-title"><%= account && account.region_code ? account.region_code : '' %></span>
      </h3>
      <div id="region-fields" class="space-y-4">
        <% if (isEdit && account.fields && account.fields.length > 0) { %>
          <% account.fields.filter(f => !f.is_custom).forEach((f, i) => { %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                <%= f.field_label %><% if (f.required) { %> <span class="text-red-500">*</span><% } %>
              </label>
              <input type="hidden" name="field_key[]" value="<%= f.field_key %>">
              <input type="hidden" name="field_label[]" value="<%= f.field_label %>">
              <input type="hidden" name="field_type[]" value="<%= f.field_type || 'text' %>">
              <input type="hidden" name="field_is_custom[]" value="0">
              <% if (f.field_type === 'textarea') { %>
                <textarea name="field_value[]" rows="3"
                          class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"><%= f.field_value || '' %></textarea>
              <% } else if (f.field_type === 'select' && f.options) { %>
                <select name="field_value[]" class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                  <option value="">Select…</option>
                  <% f.options.forEach(opt => { %>
                    <option value="<%= opt %>" <%= f.field_value === opt ? 'selected' : '' %>><%= opt %></option>
                  <% }) %>
                </select>
              <% } else { %>
                <input type="text" name="field_value[]"
                       value="<%= f.field_value || '' %>"
                       placeholder="<%= f.placeholder || '' %>"
                       class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <% } %>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-5">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Custom Fields</h3>
        <button type="button" id="add-custom-field"
                class="text-sm text-blue-600 hover:text-blue-700 font-medium">
          + Add Custom Field
        </button>
      </div>
      <div id="custom-fields" class="space-y-3">
        <% if (isEdit && account.fields) { %>
          <% account.fields.filter(f => f.is_custom).forEach((f, i) => { %>
            <div class="flex gap-2 items-start custom-field-row">
              <input type="text" name="field_key[]" value="<%= f.field_key %>" placeholder="Key"
                     class="block w-1/4 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <input type="text" name="field_label[]" value="<%= f.field_label %>" placeholder="Label"
                     class="block w-1/4 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <input type="text" name="field_value[]" value="<%= f.field_value || '' %>" placeholder="Value"
                     class="block flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <input type="hidden" name="field_type[]" value="text">
              <input type="hidden" name="field_is_custom[]" value="1">
              <button type="button" onclick="this.closest('.custom-field-row').remove()"
                      class="px-2 py-2 text-red-400 hover:text-red-600 text-lg">✕</button>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
      <textarea id="notes" name="notes" rows="3"
                placeholder="Optional notes about this account"
                class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"><%= account ? account.notes || '' : '' %></textarea>
    </div>

    <div class="flex gap-3">
      <button type="submit"
              class="px-6 py-2.5 text-sm font-medium rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors">
        <%= isEdit ? 'Update Account' : 'Create Account' %>
      </button>
      <a href="/accounts" class="px-6 py-2.5 text-sm font-medium rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors">
        Cancel
      </a>
    </div>
  </form>
</div>

<script src="/js/region-fields.js"></script>
<script>
  document.getElementById('add-custom-field').addEventListener('click', function () {
    const container = document.getElementById('custom-fields');
    const row = document.createElement('div');
    row.className = 'flex gap-2 items-start custom-field-row';
    row.innerHTML = `
      <input type="text" name="field_key[]" placeholder="Key"
             class="block w-1/4 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      <input type="text" name="field_label[]" placeholder="Label"
             class="block w-1/4 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      <input type="text" name="field_value[]" placeholder="Value"
             class="block flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      <input type="hidden" name="field_type[]" value="text">
      <input type="hidden" name="field_is_custom[]" value="1">
      <button type="button" onclick="this.closest('.custom-field-row').remove()"
              class="px-2 py-2 text-red-400 hover:text-red-600 text-lg">✕</button>
    `;
    container.appendChild(row);
  });
</script>

<%- include('../partials/footer') %>
