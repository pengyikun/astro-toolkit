<%- include('../partials/header') %>

<section class="page-header">
  <div class="page-breadcrumbs">
    <span>Validation</span>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
    </svg>
    <span>BIC checker</span>
  </div>

  <div>
    <h1 class="console-title">BIC checker</h1>
  </div>
</section>

<div class="section-stack">
  <section class="section-block">
    <div class="console-panel">
      <div class="console-panel-body">
        <form method="POST" action="/bic/check" class="space-y-4">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <label for="bic-input" class="console-label">Enter BIC or SWIFT code</label>
          <div class="flex flex-col gap-3 sm:flex-row">
            <input type="text" name="bic" id="bic-input"
                   value="<%= input %>"
                   placeholder="e.g. NWBKGB2L or NWBKGB2LXXX"
                   autocomplete="off"
                   class="console-input flex-1 font-mono text-base tracking-[0.16em]">
            <button type="submit" class="console-button-primary whitespace-nowrap sm:min-w-[8rem]">
              Validate
            </button>
          </div>
        </form>

        <div class="helper-list mt-5">
          <div class="helper-row">
            <svg class="w-4 h-4 text-ink-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
            </svg>
            <span>Supports both 8-character institution codes and 11-character branch-specific codes. Case does not matter.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <% if (result) { %>
    <section class="section-block">
      <% if (result.valid) { %>
        <div class="console-panel overflow-hidden border-l-4 border-l-success">
          <div class="px-6 pt-6 pb-4">
            <div class="flex items-center gap-2 mb-4">
              <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              <span class="text-sm font-semibold text-success">Valid BIC or SWIFT</span>
            </div>
            <div class="font-mono text-lg tracking-widest text-ink bg-page rounded-lg px-4 py-3 text-center">
              <%= result.bic %>
            </div>
          </div>
          <div class="px-6 pb-6">
            <dl class="grid grid-cols-1 gap-x-8 sm:grid-cols-2">
              <div class="space-y-0 divide-y divide-border">
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Institution Code</dt>
                  <dd class="text-sm text-ink font-mono"><%= result.institution_code %></dd>
                </div>
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Country</dt>
                  <dd class="text-sm text-ink"><%= result.country_name %> (<%= result.country_code %>)</dd>
                </div>
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Location Code</dt>
                  <dd class="text-sm text-ink font-mono"><%= result.location_code %></dd>
                </div>
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Branch Code</dt>
                  <dd class="text-sm text-ink font-mono"><%= result.branch_code || 'N/A (8-char BIC)' %></dd>
                </div>
              </div>
              <div class="space-y-0 divide-y divide-border">
                <div class="flex justify-between items-center py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Primary Office</dt>
                  <dd>
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= result.is_primary_office ? 'bg-success-light text-success' : 'bg-page text-ink-secondary' %>">
                      <%= result.is_primary_office ? 'Yes' : 'No' %>
                    </span>
                  </dd>
                </div>
                <div class="flex justify-between items-center py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Test BIC</dt>
                  <dd>
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= result.is_test_bic ? 'bg-warning-light text-warning' : 'bg-page text-ink-secondary' %>">
                      <%= result.is_test_bic ? 'Yes' : 'No' %>
                    </span>
                  </dd>
                </div>
                <div class="flex justify-between items-center py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Passive Participant</dt>
                  <dd>
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= result.is_passive_participant ? 'bg-warning-light text-warning' : 'bg-page text-ink-secondary' %>">
                      <%= result.is_passive_participant ? 'Yes' : 'No' %>
                    </span>
                  </dd>
                </div>
                <div class="flex justify-between items-center py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Reverse Billing</dt>
                  <dd>
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= result.is_reverse_billing ? 'bg-brand-light text-brand' : 'bg-page text-ink-secondary' %>">
                      <%= result.is_reverse_billing ? 'Yes' : 'No' %>
                    </span>
                  </dd>
                </div>
              </div>
            </dl>

            <% if (leiEntity) { %>
              <div class="border-t border-border mt-3 pt-3">
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">LEI</dt>
                  <dd class="text-sm text-ink font-mono"><%= leiEntity.lei %></dd>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <% if (leiEntity) { %>
          <div class="console-panel overflow-hidden mt-4">
            <button type="button" onclick="this.parentElement.querySelector('#gleif-details').classList.toggle('hidden'); this.querySelector('.gleif-chevron').classList.toggle('rotate-180')"
                    class="w-full px-6 py-4 flex items-center justify-between hover:bg-page/60 transition-colors">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" /></svg>
                <span class="text-sm font-medium text-ink"><%= leiEntity.legalName %></span>
                <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= leiEntity.status === 'ACTIVE' ? 'bg-success-light text-success' : 'bg-page text-ink-secondary' %>">
                  <%= leiEntity.status %>
                </span>
              </div>
              <svg class="gleif-chevron w-4 h-4 text-ink-muted transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </button>
            <div id="gleif-details" class="hidden border-t border-border">
              <div class="px-6 py-4">
                <div class="flex items-center gap-2 mb-3">
                  <% if (leiEntity.registrationStatus) { %>
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= leiEntity.registrationStatus === 'ISSUED' ? 'bg-brand-light text-brand' : 'bg-warning-light text-warning' %>">
                      <%= leiEntity.registrationStatus %>
                    </span>
                  <% } %>
                </div>
                <dl class="divide-y divide-border">
                  <% if (leiEntity.jurisdiction) { %>
                    <div class="flex justify-between py-2.5">
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Jurisdiction</dt>
                      <dd class="text-sm text-ink"><%= leiEntity.jurisdiction %></dd>
                    </div>
                  <% } %>
                  <% if (leiEntity.category) { %>
                    <div class="flex justify-between py-2.5">
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Category</dt>
                      <dd class="text-sm text-ink"><%= leiEntity.category.replace(/_/g, ' ').toLowerCase().replace(/^./, c => c.toUpperCase()) %></dd>
                    </div>
                  <% } %>

                  <%
                    const legalAddr = leiEntity.legalAddress;
                    const hasLegalAddr = legalAddr && (legalAddr.addressLines.length > 0 || legalAddr.city || legalAddr.country);
                  %>
                  <% if (hasLegalAddr) { %>
                    <div class="py-2.5">
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider mb-1.5">Legal Address</dt>
                      <dd class="text-sm text-ink space-y-0.5">
                        <% legalAddr.addressLines.forEach(line => { %>
                          <p><%= line %></p>
                        <% }) %>
                        <p>
                          <%= [legalAddr.city, legalAddr.region].filter(Boolean).join(', ') %>
                          <%= legalAddr.postalCode ? ' ' + legalAddr.postalCode : '' %>
                        </p>
                        <% if (legalAddr.country) { %><p><%= legalAddr.country %></p><% } %>
                      </dd>
                    </div>
                  <% } %>

                  <%
                    const hqAddr = leiEntity.headquartersAddress;
                    const hasHqAddr = hqAddr && (hqAddr.addressLines.length > 0 || hqAddr.city || hqAddr.country);
                    const hqDiffers = hasHqAddr && JSON.stringify(hqAddr) !== JSON.stringify(legalAddr);
                  %>
                  <% if (hqDiffers) { %>
                    <div class="py-2.5">
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider mb-1.5">Headquarters</dt>
                      <dd class="text-sm text-ink space-y-0.5">
                        <% hqAddr.addressLines.forEach(line => { %>
                          <p><%= line %></p>
                        <% }) %>
                        <p>
                          <%= [hqAddr.city, hqAddr.region].filter(Boolean).join(', ') %>
                          <%= hqAddr.postalCode ? ' ' + hqAddr.postalCode : '' %>
                        </p>
                        <% if (hqAddr.country) { %><p><%= hqAddr.country %></p><% } %>
                      </dd>
                    </div>
                  <% } %>
                </dl>
              </div>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div class="console-panel overflow-hidden border-l-4 border-l-danger">
          <div class="px-6 py-6">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-danger" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
              <span class="text-sm font-semibold text-danger">Invalid BIC or SWIFT</span>
            </div>
            <% if (input) { %>
              <div class="font-mono text-sm tracking-widest text-ink-secondary bg-page rounded-lg px-4 py-3 text-center mb-4">
                <%= input %>
              </div>
            <% } %>
            <p class="text-sm text-ink-secondary"><%= result.error %></p>
          </div>
        </div>
      <% } %>
    </section>
  <% } %>
</div>

<%- include('../partials/footer') %>
