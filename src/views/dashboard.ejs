<%- include('partials/header') %>

<div class="mb-8">
  <h1 class="text-2xl font-semibold text-ink tracking-tight">Overview</h1>
  <p class="text-sm text-ink-secondary mt-1">Your toolkit at a glance</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
  <a href="/accounts" class="group block rounded-xl border border-border bg-white p-5 hover:shadow-sm hover:border-brand/20 transition-all">
    <div class="flex items-center justify-between mb-4">
      <div class="w-9 h-9 rounded-lg bg-brand/[0.08] flex items-center justify-center">
        <svg class="w-[18px] h-[18px] text-brand" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" /></svg>
      </div>
      <svg class="w-4 h-4 text-ink-muted opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
    </div>
    <div class="text-3xl font-semibold text-ink tracking-tight mb-1"><%= accountCount %></div>
    <p class="text-[13px] text-ink-secondary">Test Accounts</p>
  </a>

  <a href="/vault" class="group block rounded-xl border border-border bg-white p-5 hover:shadow-sm hover:border-brand/20 transition-all">
    <div class="flex items-center justify-between mb-4">
      <div class="w-9 h-9 rounded-lg bg-[#0570de]/[0.08] flex items-center justify-center">
        <svg class="w-[18px] h-[18px] text-[#0570de]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
      </div>
      <svg class="w-4 h-4 text-ink-muted opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
    </div>
    <div class="text-3xl font-semibold text-ink tracking-tight mb-1"><%= credentialCount %></div>
    <p class="text-[13px] text-ink-secondary">Credential Sets</p>
  </a>

  <a href="/penny-log" class="group block rounded-xl border border-border bg-white p-5 hover:shadow-sm hover:border-brand/20 transition-all">
    <div class="flex items-center justify-between mb-4">
      <div class="w-9 h-9 rounded-lg bg-[#0ea5e9]/[0.08] flex items-center justify-center">
        <svg class="w-[18px] h-[18px] text-[#0ea5e9]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
      </div>
      <svg class="w-4 h-4 text-ink-muted opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
    </div>
    <div class="text-3xl font-semibold text-ink tracking-tight mb-1"><%= pennyLogCount %></div>
    <p class="text-[13px] text-ink-secondary">Test Transactions</p>
  </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
  <div class="rounded-xl border border-border bg-white p-6">
    <h3 class="text-sm font-semibold text-ink mb-4">Quick Links</h3>
    <div class="grid grid-cols-2 gap-3">
      <a href="/accounts/new" class="group flex items-start gap-3 p-3.5 rounded-lg border border-border hover:border-brand/20 hover:shadow-sm transition-all">
        <div class="w-8 h-8 rounded-lg bg-brand/[0.06] flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg class="w-4 h-4 text-brand" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        </div>
        <div>
          <p class="text-[13px] font-medium text-ink">Create Account</p>
          <p class="text-[11px] text-ink-muted mt-0.5">Add a new test bank account</p>
        </div>
      </a>
      <a href="/penny-log/new" class="group flex items-start gap-3 p-3.5 rounded-lg border border-border hover:border-brand/20 hover:shadow-sm transition-all">
        <div class="w-8 h-8 rounded-lg bg-[#0ea5e9]/[0.06] flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg class="w-4 h-4 text-[#0ea5e9]" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
        </div>
        <div>
          <p class="text-[13px] font-medium text-ink">Log Transaction</p>
          <p class="text-[11px] text-ink-muted mt-0.5">Record a penny test result</p>
        </div>
      </a>
      <a href="/vault/new" class="group flex items-start gap-3 p-3.5 rounded-lg border border-border hover:border-brand/20 hover:shadow-sm transition-all">
        <div class="w-8 h-8 rounded-lg bg-[#0570de]/[0.06] flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg class="w-4 h-4 text-[#0570de]" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" /></svg>
        </div>
        <div>
          <p class="text-[13px] font-medium text-ink">Add Credentials</p>
          <p class="text-[11px] text-ink-muted mt-0.5">Store sandbox API keys</p>
        </div>
      </a>
      <a href="/data" class="group flex items-start gap-3 p-3.5 rounded-lg border border-border hover:border-brand/20 hover:shadow-sm transition-all">
        <div class="w-8 h-8 rounded-lg bg-[#7c3aed]/[0.06] flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg class="w-4 h-4 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
        </div>
        <div>
          <p class="text-[13px] font-medium text-ink">Export / Import</p>
          <p class="text-[11px] text-ink-muted mt-0.5">Backup and restore data</p>
        </div>
      </a>
    </div>
  </div>

  <div class="rounded-xl border border-border bg-white p-6">
    <h3 class="text-sm font-semibold text-ink mb-4">Validation Tools</h3>
    <div class="space-y-2">
      <a href="/iban" class="group flex items-center gap-3 px-3.5 py-3 rounded-lg hover:bg-page transition-colors">
        <div class="w-8 h-8 rounded-lg bg-page flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
        </div>
        <div class="flex-1">
          <p class="text-[13px] font-medium text-ink">IBAN Validator &amp; Parser</p>
          <p class="text-[11px] text-ink-muted">Validate format and extract embedded data</p>
        </div>
        <svg class="w-4 h-4 text-ink-muted opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
      </a>
      <a href="/bic" class="group flex items-center gap-3 px-3.5 py-3 rounded-lg hover:bg-page transition-colors">
        <div class="w-8 h-8 rounded-lg bg-page flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.467.732-3.558" /></svg>
        </div>
        <div class="flex-1">
          <p class="text-[13px] font-medium text-ink">BIC/SWIFT Validator &amp; Parser</p>
          <p class="text-[11px] text-ink-muted">Validate and parse institution codes</p>
        </div>
        <svg class="w-4 h-4 text-ink-muted opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
      </a>
      <a href="/json-parser" class="group flex items-center gap-3 px-3.5 py-3 rounded-lg hover:bg-page transition-colors">
        <div class="w-8 h-8 rounded-lg bg-page flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>
        </div>
        <div class="flex-1">
          <p class="text-[13px] font-medium text-ink">Smart JSON Parser</p>
          <p class="text-[11px] text-ink-muted">Parse, validate, and repair JSON</p>
        </div>
        <svg class="w-4 h-4 text-ink-muted opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
      </a>
      <a href="/xml-parser" class="group flex items-center gap-3 px-3.5 py-3 rounded-lg hover:bg-page transition-colors">
        <div class="w-8 h-8 rounded-lg bg-page flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
        </div>
        <div class="flex-1">
          <p class="text-[13px] font-medium text-ink">Smart XML Parser</p>
          <p class="text-[11px] text-ink-muted">Parse, validate, and convert XML</p>
        </div>
        <svg class="w-4 h-4 text-ink-muted opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
