<%- include('partials/header') %>

<%
  const statusTone = {
    success: 'success',
    pending: 'warning',
    failed: 'danger',
    timeout: 'neutral',
    returned: 'brand',
  };
  const failedCount = (typeof statusCounts !== 'undefined' && statusCounts.failed) || 0;
  const pendingCount = (typeof statusCounts !== 'undefined' && statusCounts.pending) || 0;
  const attentionCount = failedCount + pendingCount;
%>

<section class="page-header">
  <div class="page-header-row">
    <div>
      <h1 class="console-title">Overview</h1>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/penny-log/new" class="console-button-primary">Record Transaction</a>
      <a href="/accounts/new" class="console-button-ghost">New account</a>
    </div>
  </div>
</section>

<div class="section-stack">
  <section class="section-block">
    <div class="section-head">
      <h2 class="console-section-title">At a glance</h2>
    </div>

    <dl class="dashboard-strip" aria-label="Workspace totals">
      <div class="dashboard-strip-item">
        <dt>Accounts</dt>
        <dd><%= accountCount %></dd>
      </div>
      <div class="dashboard-strip-item">
        <dt>Credentials</dt>
        <dd><%= credentialCount %></dd>
      </div>
      <div class="dashboard-strip-item">
        <dt>Transactions</dt>
        <dd><%= pennyLogCount %></dd>
      </div>
    </dl>

    <div class="dashboard-links" aria-label="Primary actions">
      <a href="/accounts/new" class="dashboard-link">Create account</a>
      <a href="/vault/new" class="dashboard-link">Store credentials</a>
      <a href="/iban" class="dashboard-link">Validate IBAN</a>
      <a href="/settings" class="dashboard-link">Open settings</a>
    </div>
  </section>

  <section class="grid gap-6 xl:grid-cols-[minmax(0,1.3fr)_minmax(280px,0.7fr)]">
    <div class="section-block">
      <div class="section-head">
        <h2 class="console-section-title">Latest transactions</h2>
        <a href="/penny-log" class="section-link">View all</a>
      </div>

      <% if (typeof recentLogs !== 'undefined' && recentLogs.length > 0) { %>
        <div class="live-feed">
          <% recentLogs.forEach(function (log) { %>
            <div class="feed-row">
              <span class="feed-marker" style="
                background:
                  <%= log.status === 'failed' ? 'var(--danger)' :
                      log.status === 'pending' ? 'var(--warning)' :
                      log.status === 'returned' ? 'var(--brand)' :
                      log.status === 'timeout' ? 'var(--ink-muted)' :
                      'var(--success)' %>;
              "></span>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h4 dir="auto"><%= log.partner_name %></h4>
                  <span class="signal-chip <%= statusTone[log.status] || 'neutral' %>"><%= log.status %></span>
                </div>
                <p>
                  <span class="font-mono"><%= log.amount %> <%= log.currency %></span>
                  <span class="mx-1 text-ink-muted">/</span>
                  <%= log.direction %>
                  <span class="mx-1 text-ink-muted">/</span>
                  <span dir="auto"><%= log.reference_id || 'no reference logged' %></span>
                </p>
                <a href="/penny-log/<%= log.id %>" class="mt-2 inline-flex text-sm font-semibold text-brand hover:text-brand-dark">Inspect</a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="console-empty">
          <div class="console-empty-icon">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
          </div>
          <div>
            <h3>No transaction feed yet</h3>
            <p>Recorded runs will appear here once testing begins.</p>
          </div>
          <div class="console-empty-actions">
            <a href="/penny-log/new" class="console-button-primary">Record Transaction</a>
          </div>
        </div>
      <% } %>
    </div>

    <div class="section-block">
      <div class="section-head">
        <h2 class="console-section-title">Needs attention</h2>
      </div>

      <div class="live-feed live-feed-compact">
        <% if (failedCount > 0) { %>
          <div class="feed-row">
            <span class="feed-marker" style="background: var(--danger);"></span>
            <div>
              <h4><%= failedCount %> failed transaction<%= failedCount !== 1 ? 's' : '' %></h4>
              <a href="/penny-log?status=failed" class="mt-2 inline-flex text-sm font-semibold text-brand hover:text-brand-dark">Open failure queue</a>
            </div>
          </div>
        <% } %>

        <% if (pendingCount > 0) { %>
          <div class="feed-row">
            <span class="feed-marker" style="background: var(--warning);"></span>
            <div>
              <h4><%= pendingCount %> pending transaction<%= pendingCount !== 1 ? 's' : '' %></h4>
              <a href="/penny-log?status=pending" class="mt-2 inline-flex text-sm font-semibold text-brand hover:text-brand-dark">Review pending runs</a>
            </div>
          </div>
        <% } %>

        <% if (attentionCount === 0) { %>
          <div class="feed-row">
            <span class="feed-marker" style="background: var(--success);"></span>
            <div>
              <h4>Nothing urgent right now</h4>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </section>
</div>

<%- include('partials/footer') %>
