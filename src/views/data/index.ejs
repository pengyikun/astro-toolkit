<%- include('../partials/header') %>

<section class="page-header">
  <div class="page-breadcrumbs">
    <span>Workspace</span>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
    </svg>
    <span>Settings</span>
  </div>

  <div>
    <h1 class="console-title">Settings</h1>
  </div>
</section>

<div class="section-stack">
  <% if (importResult) { %>
    <div class="px-4 py-4 rounded-lg bg-success-light border border-success-border text-success text-sm">
      <p class="font-medium mb-2">
        <svg class="w-4 h-4 inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        Import Complete
      </p>
      <ul class="list-disc list-inside space-y-1">
        <li><%= importResult.accounts %> account(s) imported</li>
        <li><%= importResult.credentials %> credential set(s) imported</li>
        <li><%= importResult.penny_test_logs %> test transaction(s) imported</li>
      </ul>
    </div>
  <% } %>

  <section class="section-block">
    <div class="section-head">
      <h2 class="console-section-title">Data management</h2>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 items-start">
    <div class="console-panel">
      <div class="console-panel-body flex flex-col h-full">
        <h3 class="text-sm font-semibold text-ink mb-1">Export data</h3>
        <p class="text-[13px] text-ink-secondary mb-5">Download selected modules as a JSON file.</p>

        <form method="POST" action="/settings/export" class="flex flex-col flex-1">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div class="space-y-3 mb-5">
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="accounts" value="1" class="rounded border-input-border text-brand focus:ring-brand">
              <span class="text-sm text-ink">Accounts</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="credentials" value="1" class="rounded border-input-border text-brand focus:ring-brand">
              <span class="text-sm text-ink">Credentials Vault</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="penny_test_logs" value="1" class="rounded border-input-border text-brand focus:ring-brand">
              <span class="text-sm text-ink">Test Transactions</span>
            </label>
          </div>

          <div class="bg-warning-light border border-warning-border rounded-md px-4 py-3 mb-5">
            <p class="text-xs text-warning">
              <svg class="w-3.5 h-3.5 inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
              <strong>Warning:</strong> Exported files contain plaintext secrets from the vault. Do not commit export files to version control.
            </p>
          </div>

          <div class="mt-auto">
            <button type="submit" class="console-button-primary">Export Selected</button>
          </div>
        </form>
      </div>
    </div>

    <div class="console-panel">
      <div class="console-panel-body flex flex-col h-full">
        <h3 class="text-sm font-semibold text-ink mb-1">Import data</h3>
        <p class="text-[13px] text-ink-secondary mb-5">Upload a previously exported JSON file to restore data.</p>

        <form method="POST" action="/settings/import" enctype="multipart/form-data" class="flex flex-col flex-1">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div class="mb-5">
            <label for="file" class="block text-sm font-medium text-ink mb-2">JSON File</label>
            <label for="file" class="flex flex-col items-center justify-center w-full h-28 border-2 border-dashed border-input-border rounded-lg cursor-pointer hover:border-brand hover:bg-page transition-colors">
              <div class="flex flex-col items-center justify-center py-4">
                <svg class="w-7 h-7 text-ink-muted mb-1.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>
                <p class="text-sm text-ink-secondary"><span class="font-medium text-brand">Click to upload</span> or drag and drop</p>
                <p class="text-xs text-ink-muted mt-0.5">.json files only</p>
              </div>
              <input type="file" id="file" name="file" accept=".json" required class="hidden">
            </label>
          </div>

          <div class="space-y-3 mb-5">
            <p class="text-[11px] font-medium text-ink-secondary uppercase tracking-wider">Import modules (leave unchecked to import all available)</p>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="import_accounts" value="1" class="rounded border-input-border text-brand focus:ring-brand">
              <span class="text-sm text-ink">Accounts</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="import_credentials" value="1" class="rounded border-input-border text-brand focus:ring-brand">
              <span class="text-sm text-ink">Credentials Vault</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="import_penny_test_logs" value="1" class="rounded border-input-border text-brand focus:ring-brand">
              <span class="text-sm text-ink">Test Transactions</span>
            </label>
          </div>

          <div class="mt-auto">
            <button type="submit" class="console-button-secondary">Import</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
