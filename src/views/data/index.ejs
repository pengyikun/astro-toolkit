<%- include('../partials/header') %>

<h2 class="text-2xl font-semibold text-gray-900 mb-6">Export / Import</h2>

<% if (importResult) { %>
  <div class="mb-6 px-4 py-4 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm">
    <p class="font-medium mb-2">✓ Import Complete</p>
    <ul class="list-disc list-inside space-y-1">
      <li><%= importResult.accounts %> account(s) imported</li>
      <li><%= importResult.credentials %> credential set(s) imported</li>
      <li><%= importResult.penny_test_logs %> penny test log(s) imported</li>
    </ul>
  </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-1">Export Data</h3>
    <p class="text-sm text-gray-500 mb-5">Download selected modules as a JSON file.</p>

    <form method="POST" action="/data/export">
      <div class="space-y-3 mb-6">
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="accounts" value="1"
                 class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
          <span class="text-sm text-gray-700">Accounts</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="credentials" value="1"
                 class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
          <span class="text-sm text-gray-700">Credentials Vault</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="penny_test_logs" value="1"
                 class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
          <span class="text-sm text-gray-700">Penny Test Logs</span>
        </label>
      </div>

      <div class="bg-yellow-50 border border-yellow-200 rounded-lg px-4 py-3 mb-6">
        <p class="text-xs text-yellow-800">
          ⚠️ <strong>Warning:</strong> Exported files contain plaintext secrets from the vault. Do not commit export files to version control.
        </p>
      </div>

      <button type="submit"
              class="px-5 py-2.5 text-sm font-medium rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors">
        Export Selected
      </button>
    </form>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-1">Import Data</h3>
    <p class="text-sm text-gray-500 mb-5">Upload a previously exported JSON file to restore data.</p>

    <form method="POST" action="/data/import" enctype="multipart/form-data">
      <div class="mb-5">
        <label for="file" class="block text-sm font-medium text-gray-700 mb-2">JSON File</label>
        <input type="file" id="file" name="file" accept=".json" required
               class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border file:border-gray-300 file:text-sm file:font-medium file:bg-white file:text-gray-700 hover:file:bg-gray-50">
      </div>

      <div class="space-y-3 mb-6">
        <p class="text-xs font-medium text-gray-500 uppercase">Import modules (leave unchecked to import all available)</p>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="import_accounts" value="1"
                 class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
          <span class="text-sm text-gray-700">Accounts</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="import_credentials" value="1"
                 class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
          <span class="text-sm text-gray-700">Credentials Vault</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="import_penny_test_logs" value="1"
                 class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
          <span class="text-sm text-gray-700">Penny Test Logs</span>
        </label>
      </div>

      <button type="submit"
              class="px-5 py-2.5 text-sm font-medium rounded-lg bg-gray-800 text-white hover:bg-gray-900 transition-colors">
        Import
      </button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>