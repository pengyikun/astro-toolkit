<%- include('../partials/header') %>

<div class="max-w-3xl">
  <div class="mb-6">
    <a href="/vault" class="text-sm text-gray-500 hover:text-gray-700">← Back to Vault</a>
  </div>

  <div class="flex items-start justify-between mb-6">
    <div>
      <h2 class="text-2xl font-semibold text-gray-900"><%= credential.label %></h2>
      <div class="flex items-center gap-2 mt-2">
        <span class="text-sm text-gray-500"><%= credential.partner_name %></span>
        <span class="text-gray-300">·</span>
        <%
          const envColors = {
            sandbox: 'bg-yellow-100 text-yellow-700',
            staging: 'bg-blue-100 text-blue-700',
            uat: 'bg-purple-100 text-purple-700',
          };
        %>
        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= envColors[credential.environment] || 'bg-gray-100 text-gray-600' %>">
          <%= credential.environment %>
        </span>
      </div>
    </div>
    <div class="flex gap-2">
      <a href="/vault/<%= credential.id %>/edit"
         class="px-4 py-2 text-sm font-medium rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors">
        Edit
      </a>
      <button type="button"
              onclick="openConfirmModal('/vault/<%= credential.id %>?_method=DELETE', 'Delete Credential Set', 'Are you sure? This will delete all stored secrets and files.')"
              class="px-4 py-2 text-sm font-medium rounded-lg bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 transition-colors">
        Delete
      </button>
    </div>
  </div>

  <% if (credential.notes) { %>
    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Notes</h3>
      <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= credential.notes %></p>
    </div>
  <% } %>

  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden mb-6">
    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Stored Items</h3>
    </div>
    <% if (credential.items && credential.items.length > 0) { %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="text-left px-6 py-3 font-medium text-gray-500">Key</th>
            <th class="text-left px-6 py-3 font-medium text-gray-500">Type</th>
            <th class="text-left px-6 py-3 font-medium text-gray-500">Value</th>
            <th class="text-right px-6 py-3 font-medium text-gray-500">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% credential.items.forEach(item => { %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-3 font-medium text-gray-900 font-mono text-xs"><%= item.item_key %></td>
              <td class="px-6 py-3">
                <span class="inline-block px-2 py-0.5 rounded text-xs font-medium
                  <%= item.item_type === 'file' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-600' %>">
                  <%= item.item_type %>
                </span>
              </td>
              <td class="px-6 py-3">
                <% if (item.item_type === 'file') { %>
                  <span class="text-sm text-gray-600"><%= item.file_name || 'Uploaded file' %></span>
                <% } else { %>
                  <span class="vault-secret-mask text-sm text-gray-400 font-mono" id="secret-mask-<%= item.id %>">••••••••••••</span>
                  <span class="vault-secret-value text-sm text-gray-900 font-mono hidden" id="secret-value-<%= item.id %>"></span>
                <% } %>
              </td>
              <td class="px-6 py-3 text-right">
                <div class="flex justify-end gap-2">
                  <% if (item.item_type === 'file') { %>
                    <% if (item.file_path) { %>
                      <a href="<%= item.file_path %>" download="<%= item.file_name %>"
                         class="px-2 py-1 text-xs font-medium rounded border border-gray-300 text-gray-600 hover:bg-gray-50">
                        Download
                      </a>
                    <% } %>
                  <% } else { %>
                    <button type="button"
                            onclick="revealSecret(<%= credential.id %>, <%= item.id %>)"
                            class="px-2 py-1 text-xs font-medium rounded border border-gray-300 text-gray-600 hover:bg-gray-50"
                            id="reveal-btn-<%= item.id %>">
                      Reveal
                    </button>
                    <button type="button"
                            onclick="copySecret(<%= credential.id %>, <%= item.id %>)"
                            class="px-2 py-1 text-xs font-medium rounded border border-gray-300 text-gray-600 hover:bg-gray-50">
                      Copy
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div class="px-6 py-8 text-center text-gray-400 text-sm">No items stored.</div>
    <% } %>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <dl class="grid grid-cols-2 gap-x-8 gap-y-4">
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Created</dt>
        <dd class="text-sm text-gray-900 mt-0.5"><%= new Date(credential.created_at).toLocaleString() %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-400 uppercase">Updated</dt>
        <dd class="text-sm text-gray-900 mt-0.5"><%= new Date(credential.updated_at).toLocaleString() %></dd>
      </div>
    </dl>
  </div>
</div>

<script src="/js/vault-toggle.js"></script>
<script>
  async function revealSecret(credId, itemId) {
    try {
      const res = await fetch(`/api/vault/${credId}/reveal/${itemId}`);
      const data = await res.json();
      if (data.value !== undefined) {
        const mask = document.getElementById(`secret-mask-${itemId}`);
        const value = document.getElementById(`secret-value-${itemId}`);
        const btn = document.getElementById(`reveal-btn-${itemId}`);
        mask.classList.add('hidden');
        value.textContent = data.value;
        value.classList.remove('hidden');
        btn.textContent = 'Hide';
        btn.onclick = function () {
          mask.classList.remove('hidden');
          value.classList.add('hidden');
          btn.textContent = 'Reveal';
          btn.onclick = function () { revealSecret(credId, itemId); };
        };
        setTimeout(function () {
          mask.classList.remove('hidden');
          value.classList.add('hidden');
          btn.textContent = 'Reveal';
          btn.onclick = function () { revealSecret(credId, itemId); };
        }, 10000);
      }
    } catch (e) {
      alert('Failed to reveal secret.');
    }
  }

  async function copySecret(credId, itemId) {
    try {
      const res = await fetch(`/api/vault/${credId}/reveal/${itemId}`);
      const data = await res.json();
      if (data.value !== undefined) {
        await navigator.clipboard.writeText(data.value);
        const btn = event.target;
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 2000);
      }
    } catch (e) {
      alert('Failed to copy secret.');
    }
  }
</script>

<%- include('../partials/footer') %>
