<%- include('../partials/header') %>

<%
  const envTone = credential.environment === 'sandbox' ? 'warning' : credential.environment === 'staging' ? 'brand' : 'neutral';
%>

<section class="page-header">
  <div class="page-breadcrumbs">
    <a href="/vault" class="font-medium hover:text-ink">Vault</a>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
    </svg>
    <span><%= credential.partner_name %></span>
  </div>

  <div class="page-header-row">
    <div class="max-w-2xl">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="console-title"><%= credential.partner_name %></h1>
        <span class="signal-chip <%= envTone %>"><%= credential.environment %></span>
      </div>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/vault/<%= credential.id %>/edit" class="console-button-secondary">Edit Set</a>
      <button type="button" class="console-button-danger" onclick="openConfirmModal('/vault/<%= credential.id %>?_method=DELETE', 'Delete Credential Set', 'Delete &quot;<%= credential.label %>&quot; (<%= credential.partner_name %> / <%= credential.environment %>)? All stored secrets and files will be permanently removed.')">Delete</button>
    </div>
  </div>
</section>

<section class="section-stack">
  <div class="console-summary-grid">
    <div class="console-summary-card">
      <div class="console-summary-label">Label</div>
      <div class="console-summary-value"><%= credential.label %></div>
    </div>
    <div class="console-summary-card">
      <div class="console-summary-label">Environment</div>
      <div class="console-summary-value"><%= credential.environment %></div>
    </div>
    <div class="console-summary-card">
      <div class="console-summary-label">Stored items</div>
      <div class="console-summary-value"><%= credential.items ? credential.items.length : 0 %></div>
    </div>
    <div class="console-summary-card">
      <div class="console-summary-label">Created</div>
      <div class="console-summary-value"><%= new Date(credential.created_at).toLocaleString() %></div>
    </div>
    <div class="console-summary-card">
      <div class="console-summary-label">Updated</div>
      <div class="console-summary-value"><%= new Date(credential.updated_at).toLocaleString() %></div>
    </div>
  </div>
</section>

<% if (credential.notes) { %>
  <div class="console-panel mt-6">
    <div class="console-panel-body">
      <div class="console-kicker">Operator notes</div>
      <p class="mt-4 text-sm leading-relaxed text-ink-secondary whitespace-pre-wrap"><%= credential.notes %></p>
    </div>
  </div>
<% } %>

<div class="console-table-wrap mt-6">
  <div class="console-panel-header">
    <div>
      <div class="console-kicker">Stored material</div>
      <h2 class="console-section-title mt-3">Secrets and files in this set</h2>
    </div>
  </div>

  <% if (credential.items && credential.items.length > 0) { %>
    <div class="record-stack lg:hidden px-4 pb-4">
      <% credential.items.forEach(item => { %>
        <article class="record-card">
          <div class="record-card-header">
            <div>
              <div class="record-card-title font-mono"><%= item.item_key %></div>
              <p class="record-card-copy"><%= item.item_type === 'file' ? (item.file_name || 'Uploaded file') : 'Secret value masked by default' %></p>
            </div>
            <span class="signal-chip <%= item.item_type === 'file' ? 'brand' : 'neutral' %>"><%= item.item_type %></span>
          </div>
          <% if (item.item_type !== 'file') { %>
            <div class="mt-4 text-sm font-mono text-ink-muted">
              <span class="vault-secret-mask" data-mask-item="<%= item.id %>">••••••••••••</span>
              <span class="vault-secret-value hidden text-ink" data-value-item="<%= item.id %>"></span>
            </div>
          <% } %>
          <div class="record-actions">
            <% if (item.item_type === 'file') { %>
              <% if (item.file_path) { %>
                <a href="<%= item.file_path %>" download="<%= item.file_name %>" class="table-action-link">Download</a>
              <% } %>
            <% } else { %>
              <button type="button" class="table-action-link" data-reveal-item="<%= item.id %>" onclick="revealSecret(<%= credential.id %>, <%= item.id %>)">Show</button>
              <button type="button" class="table-action-link" onclick="copySecret(<%= credential.id %>, <%= item.id %>, this)">Copy</button>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>

    <div class="overflow-x-auto hidden lg:block">
      <table class="console-table">
        <thead>
          <tr>
            <th>Key</th>
            <th>Type</th>
            <th>Value</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% credential.items.forEach(item => { %>
            <tr>
              <td class="font-mono font-semibold"><%= item.item_key %></td>
              <td><span class="signal-chip <%= item.item_type === 'file' ? 'brand' : 'neutral' %>"><%= item.item_type %></span></td>
              <td>
                <% if (item.item_type === 'file') { %>
                  <span class="text-ink-secondary"><%= item.file_name || 'Uploaded file' %></span>
                <% } else { %>
                  <span class="vault-secret-mask text-sm text-ink-muted font-mono" data-mask-item="<%= item.id %>">••••••••••••</span>
                  <span class="vault-secret-value text-sm text-ink font-mono hidden" data-value-item="<%= item.id %>"></span>
                <% } %>
              </td>
              <td class="text-right">
                <div class="table-actions justify-end">
                  <% if (item.item_type === 'file') { %>
                    <% if (item.file_path) { %>
                      <a href="<%= item.file_path %>" download="<%= item.file_name %>" class="table-action-link">Download</a>
                    <% } %>
                  <% } else { %>
                    <button type="button" class="table-action-link" data-reveal-item="<%= item.id %>" onclick="revealSecret(<%= credential.id %>, <%= item.id %>)">Show</button>
                    <button type="button" class="table-action-link" onclick="copySecret(<%= credential.id %>, <%= item.id %>, this)">Copy</button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="console-empty m-4">
      <div class="console-empty-icon">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </div>
      <div>
        <h3>No stored items yet</h3>
        <p>This credential set exists, but it still needs the secret values or files the operator actually uses.</p>
      </div>
    </div>
  <% } %>
</div>

<div id="toast-container" class="fixed right-6 top-24 z-50 space-y-2"></div>

<script>
  function showToast(message, type) {
    var container = document.getElementById('toast-container');
    var toast = document.createElement('div');
    toast.className = 'toast-enter px-4 py-3 rounded-[1.15rem] text-[13px] flex items-center gap-2 shadow-lg min-w-[280px] border '
      + (type === 'success'
        ? 'bg-success-light border-success-border text-success'
        : 'bg-danger-light border-danger-border text-danger');
    toast.innerHTML = (type === 'success'
      ? '<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>'
      : '<svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>')
      + '<span class="flex-1">' + message + '</span>';
    toast.addEventListener('animationend', function () {
      if (toast.classList.contains('toast-dismiss')) toast.remove();
    });
    container.appendChild(toast);
    setTimeout(function () { toast.classList.replace('toast-enter', 'toast-dismiss'); }, 4000);
  }

  async function revealSecret(credId, itemId) {
    try {
      var res = await fetch('/api/vault/' + credId + '/reveal/' + itemId);
      var data = await res.json();
      if (data.value !== undefined) {
        var masks = document.querySelectorAll('[data-mask-item="' + itemId + '"]');
        var values = document.querySelectorAll('[data-value-item="' + itemId + '"]');
        var buttons = document.querySelectorAll('[data-reveal-item="' + itemId + '"]');
        masks.forEach(function (mask) { mask.classList.add('hidden'); });
        values.forEach(function (value) {
          value.textContent = data.value;
          value.classList.remove('hidden');
        });
        buttons.forEach(function (btn) {
          btn.textContent = 'Hide';
          btn.onclick = function () {
            masks.forEach(function (mask) { mask.classList.remove('hidden'); });
            values.forEach(function (value) { value.classList.add('hidden'); });
            buttons.forEach(function (resetBtn) {
              resetBtn.textContent = 'Show';
              resetBtn.onclick = function () { revealSecret(credId, itemId); };
            });
          };
        });
        setTimeout(function () {
          masks.forEach(function (mask) { mask.classList.remove('hidden'); });
          values.forEach(function (value) { value.classList.add('hidden'); });
          buttons.forEach(function (btn) {
            btn.textContent = 'Show';
            btn.onclick = function () { revealSecret(credId, itemId); };
          });
        }, 10000);
      }
    } catch (e) {
      showToast('Failed to reveal secret.', 'error');
    }
  }

  async function copySecret(credId, itemId, btn) {
    try {
      var res = await fetch('/api/vault/' + credId + '/reveal/' + itemId);
      var data = await res.json();
      if (data.value !== undefined) {
        await navigator.clipboard.writeText(data.value);
        var original = btn.innerHTML;
        btn.textContent = 'Copied';
        showToast('Secret copied to clipboard.', 'success');
        setTimeout(function () { btn.innerHTML = original; }, 2000);
      }
    } catch (e) {
      showToast('Failed to copy secret.', 'error');
    }
  }
</script>

<%- include('../partials/footer') %>
