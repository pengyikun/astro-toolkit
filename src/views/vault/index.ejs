<%- include('../partials/header') %>

<section class="page-header">
  <div class="page-breadcrumbs">
    <span>Vault</span>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
    </svg>
    <span>Credentials</span>
  </div>

  <div class="page-header-row">
    <div>
      <h1 class="console-title">Credential vault</h1>
    </div>
    <a href="/vault/new" class="console-button-primary">Add Credential Set</a>
  </div>
</section>

<form method="GET" action="/vault" class="console-toolbar list-filter-bar mt-6">
  <div class="flex flex-wrap items-center justify-end gap-4">
    <% if (filters.partner_name || filters.environment || filters.search) { %>
      <a href="/vault" class="console-button-ghost !min-h-0 !px-0 text-sm font-semibold">Reset filters</a>
    <% } %>
  </div>

  <div class="list-filter-grid lg:grid-cols-4">
    <div>
      <label class="console-label" for="vault-partner">Partner</label>
      <select id="vault-partner" name="partner_name" class="console-select">
        <option value="">All partners</option>
        <% if (typeof partners !== 'undefined') { partners.forEach(partner => { %>
          <option value="<%= partner %>" <%= filters.partner_name === partner ? 'selected' : '' %>><%= partner %></option>
        <% }) } %>
      </select>
    </div>
    <div>
      <label class="console-label" for="vault-environment">Environment</label>
      <select id="vault-environment" name="environment" class="console-select">
        <option value="">All environments</option>
        <option value="sandbox" <%= filters.environment === 'sandbox' ? 'selected' : '' %>>Sandbox</option>
        <option value="staging" <%= filters.environment === 'staging' ? 'selected' : '' %>>Staging</option>
        <option value="uat" <%= filters.environment === 'uat' ? 'selected' : '' %>>UAT</option>
      </select>
    </div>
    <div>
      <label class="console-label" for="vault-search">Search</label>
      <input type="text" id="vault-search" name="search" value="<%= filters.search || '' %>" placeholder="Partner, label, notes" class="console-input">
    </div>
    <div class="list-filter-actions">
      <button type="submit" class="console-button-secondary w-full lg:w-auto">Apply Filters</button>
    </div>
  </div>
</form>

<% if (typeof data !== 'undefined' && data.length > 0) { %>
  <div class="record-stack lg:hidden mt-6">
    <% data.forEach(cred => { %>
      <article class="record-card">
        <div class="record-card-header">
          <div>
            <div class="record-card-title" dir="auto"><%= cred.partner_name %></div>
            <p class="record-card-copy" dir="auto"><%= cred.label %></p>
          </div>
          <span class="signal-chip <%= cred.environment === 'sandbox' ? 'warning' : cred.environment === 'staging' ? 'brand' : 'neutral' %>"><%= cred.environment %></span>
        </div>
        <dl class="record-metadata">
          <div>
            <dt>Items</dt>
            <dd><%= cred.item_count || 0 %></dd>
          </div>
          <div>
            <dt>Created</dt>
            <dd><%= new Date(cred.created_at).toLocaleDateString() %></dd>
          </div>
        </dl>
        <div class="record-actions">
          <a href="/vault/<%= cred.id %>" class="table-action-link">View</a>
          <a href="/vault/<%= cred.id %>/edit" class="table-action-link">Edit</a>
          <button type="button" class="table-action-link danger" onclick="openConfirmModal('/vault/<%= cred.id %>?_method=DELETE', 'Delete Credential Set', 'Delete &quot;<%= cred.label %>&quot; (<%= cred.partner_name %> / <%= cred.environment %>)? All stored secrets and files will be permanently removed.')">Delete</button>
        </div>
      </article>
    <% }) %>
  </div>

  <div class="console-table-wrap hidden lg:block mt-6">
    <table class="console-table">
      <thead>
        <tr>
          <th>Partner</th>
          <th>Environment</th>
          <th>Label</th>
          <th>Items</th>
          <th>Created</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(cred => { %>
          <tr>
            <td><span class="table-primary-link" dir="auto"><%= cred.partner_name %></span></td>
            <td>
              <span class="signal-chip <%= cred.environment === 'sandbox' ? 'warning' : cred.environment === 'staging' ? 'brand' : 'neutral' %>"><%= cred.environment %></span>
            </td>
            <td><a href="/vault/<%= cred.id %>" class="table-primary-link hover:text-brand" dir="auto"><%= cred.label %></a></td>
            <td><%= cred.item_count || 0 %></td>
            <td><%= new Date(cred.created_at).toLocaleDateString() %></td>
            <td class="text-right">
              <div class="table-actions justify-end">
                <a href="/vault/<%= cred.id %>" class="table-action-link">View</a>
                <a href="/vault/<%= cred.id %>/edit" class="table-action-link">Edit</a>
                <button type="button" class="table-action-link danger" onclick="openConfirmModal('/vault/<%= cred.id %>?_method=DELETE', 'Delete Credential Set', 'Delete &quot;<%= cred.label %>&quot; (<%= cred.partner_name %> / <%= cred.environment %>)? All stored secrets and files will be permanently removed.')">Delete</button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <%- include('../partials/pagination') %>
  </div>
<% } else { %>
  <div class="console-table-wrap mt-6 lg:hidden">
    <div class="table-empty-card"><%= filters.partner_name || filters.environment || filters.search ? 'No credential sets found for the current filters.' : 'No credential sets yet.' %></div>
  </div>

  <div class="console-table-wrap hidden lg:block mt-6">
    <table class="console-table">
      <thead>
        <tr>
          <th>Partner</th>
          <th>Environment</th>
          <th>Label</th>
          <th>Items</th>
          <th>Created</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <tr class="table-empty-row">
          <td colspan="6"><%= filters.partner_name || filters.environment || filters.search ? 'No credential sets found for the current filters.' : 'No credential sets yet.' %></td>
        </tr>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
