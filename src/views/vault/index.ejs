<%- include('../partials/header') %>

<div class="flex items-center justify-between mb-6">
  <h2 class="text-xl font-semibold text-ink">Credentials Vault</h2>
  <a href="/vault/new"
     class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium rounded-lg bg-brand text-white hover:bg-brand-dark transition-colors">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
    Add Credential Set
  </a>
</div>

<% if (typeof data !== 'undefined' && data.length > 0) { %>
  <div class="bg-white rounded-xl border border-border overflow-hidden">
    <div class="overflow-x-auto">
    <table class="w-full text-sm min-w-[650px]">
      <thead>
        <tr class="border-b border-border">
          <th scope="col" class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Partner</th>
          <th scope="col" class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Environment</th>
          <th scope="col" class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Label</th>
          <th scope="col" class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Items</th>
          <th scope="col" class="text-left px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary">Created</th>
          <th scope="col" class="text-right px-5 py-3 text-[11px] font-semibold uppercase tracking-wider text-ink-secondary"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% data.forEach(cred => { %>
          <tr class="hover:bg-page transition-colors group">
            <td class="px-5 py-3.5 font-medium text-ink"><%= cred.partner_name %></td>
            <td class="px-5 py-3.5">
              <%
                const envColors = {
                  sandbox: 'bg-warning-light text-warning',
                  staging: 'bg-brand-light text-brand',
                  uat: 'bg-purple-light text-purple',
                };
              %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium <%= envColors[cred.environment] || 'bg-page text-ink-secondary' %>">
                <span class="w-1.5 h-1.5 rounded-full <%= cred.environment === 'sandbox' ? 'bg-warning' : cred.environment === 'staging' ? 'bg-brand' : cred.environment === 'uat' ? 'bg-purple' : 'bg-ink-muted' %>"></span>
                <%= cred.environment %>
              </span>
            </td>
            <td class="px-5 py-3.5">
              <a href="/vault/<%= cred.id %>" class="text-ink hover:text-brand font-medium"><%= cred.label %></a>
            </td>
            <td class="px-5 py-3.5 text-ink-secondary"><%= cred.item_count || 0 %></td>
            <td class="px-5 py-3.5 text-ink-secondary"><%= new Date(cred.created_at).toLocaleDateString() %></td>
            <td class="px-5 py-3.5 text-right">
              <div class="flex justify-end gap-1 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity">
                <a href="/vault/<%= cred.id %>" class="p-2 rounded-md text-ink-muted hover:text-brand hover:bg-page transition-colors" title="View" aria-label="View credential set">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                </a>
                <a href="/vault/<%= cred.id %>/edit" class="p-2 rounded-md text-ink-muted hover:text-brand hover:bg-page transition-colors" title="Edit" aria-label="Edit credential set">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" /></svg>
                </a>
                <button type="button" onclick="openConfirmModal('/vault/<%= cred.id %>?_method=DELETE', 'Delete Credential Set', 'Delete &quot;<%= cred.label %>&quot; (<%= cred.partner_name %> / <%= cred.environment %>)? All stored secrets and files will be permanently removed.')"
                        class="p-2 rounded-md text-ink-muted hover:text-danger hover:bg-danger-light transition-colors" title="Delete" aria-label="Delete credential set">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>

    <%- include('../partials/pagination') %>
  </div>
<% } else { %>
  <div class="bg-white rounded-xl border border-border px-6 py-16 text-center">
    <div class="mx-auto w-10 h-10 rounded-full bg-page flex items-center justify-center mb-4">
      <svg class="w-5 h-5 text-ink-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
    </div>
    <p class="text-sm text-ink-muted mb-1">No credential sets found.</p>
    <p class="text-[12px] text-ink-muted mb-3">Securely store sandbox API keys, secrets, and certificates per partner integration.</p>
    <a href="/vault/new" class="text-sm text-brand hover:text-brand-dark font-medium">Add your first credential set</a>
  </div>
<% } %>

<%- include('../partials/footer') %>
