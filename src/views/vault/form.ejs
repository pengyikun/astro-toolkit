<%- include('../partials/header') %>

<%
  const isEdit = credential && credential.id;
  const formAction = isEdit ? `/vault/${credential.id}?_method=PUT` : '/vault';
%>

<div class="max-w-4xl">
  <div class="mb-6">
    <a href="/vault" class="text-[13px] text-ink-secondary hover:text-ink">← Back to Vault</a>
  </div>

  <h2 class="text-xl font-semibold text-ink mb-6"><%= isEdit ? 'Edit Credential Set' : 'Add Credential Set' %></h2>

  <% if (errors) { %>
    <div class="mb-6 px-4 py-3 rounded-lg bg-danger-light border border-danger-border text-danger text-sm">
      <p class="font-medium mb-1">Please fix the following errors:</p>
      <ul class="list-disc list-inside">
        <% errors.forEach(err => { %>
          <li><%= err.field ? err.field + ': ' : '' %><%= err.message %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= formAction %>" enctype="multipart/form-data" class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div class="bg-white rounded-xl border border-border p-6 space-y-5">
      <h3 class="text-xs font-semibold text-ink-secondary uppercase tracking-wider">Credential Info</h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="partner_name" class="block text-sm font-medium text-ink mb-1.5">
            Partner Name <span class="text-danger">*</span>
          </label>
          <input type="text" id="partner_name" name="partner_name" required
                 value="<%= credential ? credential.partner_name || '' : '' %>"
                 placeholder="e.g. Braza, Fincra, OCBC"
                 class="block w-full rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
        </div>
        <div>
          <label for="environment" class="block text-sm font-medium text-ink mb-1.5">
            Environment <span class="text-danger">*</span>
          </label>
          <select id="environment" name="environment" required
                  class="block w-full rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
            <option value="sandbox" <%= (credential && credential.environment === 'sandbox') || !credential ? 'selected' : '' %>>Sandbox</option>
            <option value="staging" <%= credential && credential.environment === 'staging' ? 'selected' : '' %>>Staging</option>
            <option value="uat" <%= credential && credential.environment === 'uat' ? 'selected' : '' %>>UAT</option>
          </select>
        </div>
      </div>

      <div>
        <label for="label" class="block text-sm font-medium text-ink mb-1.5">
          Label <span class="text-danger">*</span>
        </label>
        <input type="text" id="label" name="label" required
               value="<%= credential ? credential.label || '' : '' %>"
               placeholder="e.g. Braza Sandbox API Keys"
               class="block w-full rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
      </div>

      <div>
        <label for="notes" class="block text-sm font-medium text-ink mb-1.5">Notes</label>
        <textarea id="notes" name="notes" rows="2"
                  placeholder="Optional notes"
                  class="block w-full rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand"><%= credential ? credential.notes || '' : '' %></textarea>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-border p-6 space-y-5">
      <div class="flex items-center justify-between">
        <h3 class="text-xs font-semibold text-ink-secondary uppercase tracking-wider">Secret Items</h3>
        <button type="button" id="add-item"
                class="inline-flex items-center gap-1 text-sm text-brand hover:text-brand-dark font-medium">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          Add Item
        </button>
      </div>
      <div id="vault-items" class="space-y-3">
        <% if (isEdit && credential.items && credential.items.length > 0) { %>
          <% credential.items.filter(item => item.item_type === 'text').forEach(item => { %>
            <div class="flex gap-3 items-start vault-item-row">
              <input type="text" name="item_key[]" value="<%= item.item_key %>" placeholder="Key (e.g. api_key)"
                     class="block w-1/3 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
              <input type="text" name="item_value[]" value="" placeholder="Value (leave blank to keep existing)"
                     class="block flex-1 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
              <button type="button" onclick="this.closest('.vault-item-row').remove()"
                      class="p-2 rounded-md text-ink-muted hover:text-danger hover:bg-danger-light transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
              </button>
            </div>
          <% }) %>
        <% } else if (!isEdit) { %>
          <div class="flex gap-3 items-start vault-item-row">
            <input type="text" name="item_key[]" placeholder="Key (e.g. api_key)"
                   class="block w-1/3 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
            <input type="text" name="item_value[]" placeholder="Value"
                   class="block flex-1 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
            <button type="button" onclick="this.closest('.vault-item-row').remove()"
                    class="p-2 rounded-md text-ink-muted hover:text-danger hover:bg-danger-light transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
            </button>
          </div>
        <% } %>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-border p-6 space-y-5">
      <h3 class="text-xs font-semibold text-ink-secondary uppercase tracking-wider">Certificate Upload</h3>

      <div>
        <label for="cert_key" class="block text-sm font-medium text-ink mb-1.5">Certificate Key Name</label>
        <input type="text" id="cert_key" name="cert_key"
               placeholder="e.g. tls_certificate"
               class="block w-full rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
      </div>

      <div>
        <label for="cert_file" class="block text-sm font-medium text-ink mb-1.5">Certificate File</label>
        <label for="cert_file" class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-input-border rounded-lg cursor-pointer hover:border-brand hover:bg-page transition-colors">
          <div class="flex flex-col items-center justify-center pt-5 pb-6">
            <svg class="w-8 h-8 text-ink-muted mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>
            <p class="text-sm text-ink-secondary"><span class="font-medium text-brand">Click to upload</span> or drag and drop</p>
            <p class="text-xs text-ink-muted mt-1">.pem, .crt, .cer, .p12, .pfx, .key, .jks</p>
          </div>
          <input type="file" id="cert_file" name="cert_file"
                 accept=".pem,.crt,.cer,.p12,.pfx,.key,.jks"
                 class="hidden">
        </label>
      </div>
    </div>

    <div class="flex gap-3">
      <button type="submit"
              class="px-5 py-2.5 text-sm font-medium rounded-lg bg-brand text-white hover:bg-brand-dark transition-colors">
        <%= isEdit ? 'Update Credential Set' : 'Create Credential Set' %>
      </button>
      <a href="/vault" class="px-5 py-2.5 text-sm font-medium rounded-lg border border-border text-ink hover:bg-page transition-colors">
        Cancel
      </a>
    </div>
  </form>
</div>

<script>
  document.getElementById('add-item').addEventListener('click', function () {
    const container = document.getElementById('vault-items');
    const row = document.createElement('div');
    row.className = 'flex gap-3 items-start vault-item-row';
    row.innerHTML = `
      <input type="text" name="item_key[]" placeholder="Key (e.g. api_key)"
             class="block w-1/3 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
      <input type="text" name="item_value[]" placeholder="Value"
             class="block flex-1 rounded-lg border border-input-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
      <button type="button" onclick="this.closest('.vault-item-row').remove()"
              class="p-2 rounded-md text-ink-muted hover:text-danger hover:bg-danger-light transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    `;
    container.appendChild(row);
  });
</script>

<%- include('../partials/footer') %>
