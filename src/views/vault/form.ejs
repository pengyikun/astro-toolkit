<%- include('../partials/header') %>

<%
  const isEdit = credential && credential.id;
  const formAction = isEdit ? `/vault/${credential.id}?_method=PUT` : '/vault';
%>

<div class="max-w-3xl">
  <div class="mb-6">
    <a href="/vault" class="text-sm text-gray-500 hover:text-gray-700">← Back to Vault</a>
  </div>

  <h2 class="text-2xl font-semibold text-gray-900 mb-6"><%= isEdit ? 'Edit Credential Set' : 'Add Credential Set' %></h2>

  <% if (errors) { %>
    <div class="mb-6 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm">
      <p class="font-medium mb-1">Please fix the following errors:</p>
      <ul class="list-disc list-inside">
        <% errors.forEach(err => { %>
          <li><%= err.field ? err.field + ': ' : '' %><%= err.message %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= formAction %>" enctype="multipart/form-data" class="space-y-6">
    <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-5">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Credential Info</h3>

      <div>
        <label for="partner_name" class="block text-sm font-medium text-gray-700 mb-1">
          Partner Name <span class="text-red-500">*</span>
        </label>
        <input type="text" id="partner_name" name="partner_name" required
               value="<%= credential ? credential.partner_name || '' : '' %>"
               placeholder="e.g. Braza, Fincra, OCBC"
               class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <div>
        <label for="environment" class="block text-sm font-medium text-gray-700 mb-1">
          Environment <span class="text-red-500">*</span>
        </label>
        <select id="environment" name="environment" required
                class="block w-48 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="sandbox" <%= (credential && credential.environment === 'sandbox') || !credential ? 'selected' : '' %>>Sandbox</option>
          <option value="staging" <%= credential && credential.environment === 'staging' ? 'selected' : '' %>>Staging</option>
          <option value="uat" <%= credential && credential.environment === 'uat' ? 'selected' : '' %>>UAT</option>
        </select>
      </div>

      <div>
        <label for="label" class="block text-sm font-medium text-gray-700 mb-1">
          Label <span class="text-red-500">*</span>
        </label>
        <input type="text" id="label" name="label" required
               value="<%= credential ? credential.label || '' : '' %>"
               placeholder="e.g. Braza Sandbox API Keys"
               class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <div>
        <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
        <textarea id="notes" name="notes" rows="2"
                  placeholder="Optional notes"
                  class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"><%= credential ? credential.notes || '' : '' %></textarea>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-5">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Secret Items</h3>
        <button type="button" id="add-item"
                class="text-sm text-blue-600 hover:text-blue-700 font-medium">
          + Add Item
        </button>
      </div>
      <div id="vault-items" class="space-y-3">
        <% if (isEdit && credential.items && credential.items.length > 0) { %>
          <% credential.items.filter(item => item.item_type === 'text').forEach(item => { %>
            <div class="flex gap-2 items-start vault-item-row">
              <input type="text" name="item_key[]" value="<%= item.item_key %>" placeholder="Key (e.g. api_key)"
                     class="block w-1/3 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <input type="text" name="item_value[]" value="" placeholder="Value (leave blank to keep existing)"
                     class="block flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <button type="button" onclick="this.closest('.vault-item-row').remove()"
                      class="px-2 py-2 text-red-400 hover:text-red-600 text-lg">✕</button>
            </div>
          <% }) %>
        <% } else if (!isEdit) { %>
          <div class="flex gap-2 items-start vault-item-row">
            <input type="text" name="item_key[]" placeholder="Key (e.g. api_key)"
                   class="block w-1/3 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <input type="text" name="item_value[]" placeholder="Value"
                   class="block flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <button type="button" onclick="this.closest('.vault-item-row').remove()"
                    class="px-2 py-2 text-red-400 hover:text-red-600 text-lg">✕</button>
          </div>
        <% } %>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-5">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Certificate Upload</h3>
      <div>
        <label for="cert_key" class="block text-sm font-medium text-gray-700 mb-1">Certificate Key Name</label>
        <input type="text" id="cert_key" name="cert_key"
               placeholder="e.g. tls_certificate"
               class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 mb-3">
        <label for="cert_file" class="block text-sm font-medium text-gray-700 mb-1">Certificate File</label>
        <input type="file" id="cert_file" name="cert_file"
               accept=".pem,.crt,.cer,.p12,.pfx,.key,.jks"
               class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border file:border-gray-300 file:text-sm file:font-medium file:bg-white file:text-gray-700 hover:file:bg-gray-50">
        <p class="mt-1 text-xs text-gray-400">Allowed: .pem, .crt, .cer, .p12, .pfx, .key, .jks</p>
      </div>
    </div>

    <div class="flex gap-3">
      <button type="submit"
              class="px-6 py-2.5 text-sm font-medium rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors">
        <%= isEdit ? 'Update Credential Set' : 'Create Credential Set' %>
      </button>
      <a href="/vault" class="px-6 py-2.5 text-sm font-medium rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors">
        Cancel
      </a>
    </div>
  </form>
</div>

<script>
  document.getElementById('add-item').addEventListener('click', function () {
    const container = document.getElementById('vault-items');
    const row = document.createElement('div');
    row.className = 'flex gap-2 items-start vault-item-row';
    row.innerHTML = `
      <input type="text" name="item_key[]" placeholder="Key (e.g. api_key)"
             class="block w-1/3 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      <input type="text" name="item_value[]" placeholder="Value"
             class="block flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      <button type="button" onclick="this.closest('.vault-item-row').remove()"
              class="px-2 py-2 text-red-400 hover:text-red-600 text-lg">✕</button>
    `;
    container.appendChild(row);
  });
</script>

<%- include('../partials/footer') %>
