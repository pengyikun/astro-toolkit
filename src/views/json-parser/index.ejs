<%- include('../partials/header') %>

<div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
  <!-- Left Panel: Input -->
  <div class="lg:col-span-3">
    <div class="bg-white border border-border rounded-xl p-6">
      <h2 class="text-xl font-semibold text-ink mb-1">Smart JSON Parser</h2>
      <p class="text-[13px] text-ink-secondary mb-6">Parse, validate, format, and repair broken JSON. Paste text or upload a file.</p>

      <form method="POST" action="/json-parser/parse" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="mb-4">
          <label for="json-input" class="block text-xs font-medium text-ink-secondary uppercase tracking-wider mb-2">JSON Input</label>
          <textarea name="input" id="json-input" rows="14"
                    placeholder='Paste your JSON here... e.g. {"name": "test", "value": 123}'
                    class="block w-full rounded-lg border border-input-border px-4 py-3 text-sm font-mono leading-relaxed focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand resize-y"><%= input || '' %></textarea>
        </div>

        <div class="flex items-center gap-3 mb-4">
          <span class="text-xs text-ink-muted">or</span>
          <label for="json-file" class="inline-flex items-center gap-2 px-3.5 py-2 text-sm font-medium rounded-lg border border-border text-ink-secondary hover:bg-page cursor-pointer transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>
            Upload File
            <input type="file" id="json-file" name="file" class="hidden" onchange="loadFile(this)">
          </label>
          <span id="file-name" class="text-xs text-ink-muted"></span>
        </div>

        <button type="submit"
                class="px-5 py-2.5 text-sm font-medium rounded-lg bg-brand text-white hover:bg-brand-dark transition-colors">
          Parse &amp; Validate
        </button>
      </form>
    </div>
  </div>

  <!-- Right Panel: Result -->
  <div class="lg:col-span-2">
    <% if (result) { %>
      <% if (result.valid) { %>
        <div class="bg-white border border-border rounded-xl overflow-hidden">
          <div class="px-5 py-4 border-b border-border">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              <span class="text-sm font-semibold text-success">Valid JSON</span>
              <% if (result.repaired) { %>
                <span class="inline-flex items-center gap-1 ml-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-warning-light text-warning">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.049.58.025 1.192-.14 1.743" /></svg>
                  Repaired
                </span>
              <% } %>
            </div>
          </div>

          <% if (result.stats) { %>
            <div class="px-5 py-3 border-b border-border bg-page/50">
              <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-[12px]">
                <div class="flex justify-between"><span class="text-ink-muted">Keys</span><span class="text-ink font-medium"><%= result.stats.keys %></span></div>
                <div class="flex justify-between"><span class="text-ink-muted">Depth</span><span class="text-ink font-medium"><%= result.stats.depth %></span></div>
                <div class="flex justify-between"><span class="text-ink-muted">Objects</span><span class="text-ink font-medium"><%= result.stats.objectCount %></span></div>
                <div class="flex justify-between"><span class="text-ink-muted">Arrays</span><span class="text-ink font-medium"><%= result.stats.arrayCount %></span></div>
                <div class="flex justify-between"><span class="text-ink-muted">Strings</span><span class="text-ink font-medium"><%= result.stats.stringCount %></span></div>
                <div class="flex justify-between"><span class="text-ink-muted">Numbers</span><span class="text-ink font-medium"><%= result.stats.numberCount %></span></div>
                <div class="flex justify-between"><span class="text-ink-muted">Size</span><span class="text-ink font-medium"><%= result.stats.size %> B</span></div>
              </div>
            </div>
          <% } %>

          <div class="px-5 py-3 border-b border-border">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[11px] font-semibold text-ink-secondary uppercase tracking-wider">Formatted Output</span>
              <button type="button" onclick="copyToClipboard('formatted-output')" class="text-[11px] text-brand hover:text-brand-dark font-medium">Copy</button>
            </div>
            <pre id="formatted-output" class="bg-page rounded-lg p-4 text-xs text-ink font-mono overflow-x-auto whitespace-pre-wrap max-h-80 overflow-y-auto border border-border"><%= result.formatted %></pre>
          </div>

          <div class="px-5 py-3">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[11px] font-semibold text-ink-secondary uppercase tracking-wider">Minified</span>
              <button type="button" onclick="copyToClipboard('minified-output')" class="text-[11px] text-brand hover:text-brand-dark font-medium">Copy</button>
            </div>
            <pre id="minified-output" class="bg-page rounded-lg p-3 text-xs text-ink font-mono overflow-x-auto whitespace-pre-wrap max-h-24 overflow-y-auto border border-border"><%= result.minified %></pre>
          </div>

          <div class="px-5 py-3 border-t border-border">
            <button type="button" id="btn-visualize"
                    class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-brand text-white hover:bg-brand-dark transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3.75H6A2.25 2.25 0 0 0 3.75 6v1.5M16.5 3.75H18A2.25 2.25 0 0 1 20.25 6v1.5m0 9V18A2.25 2.25 0 0 1 18 20.25h-1.5m-9 0H6A2.25 2.25 0 0 1 3.75 18v-1.5M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
              Visualize JSON
            </button>
          </div>
          <textarea id="viz-raw-json" class="hidden" aria-hidden="true"><%= result.minified %></textarea>
        </div>
      <% } else { %>
        <div class="bg-white border border-border rounded-xl border-l-4 border-l-danger overflow-hidden">
          <div class="px-5 py-5">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-danger" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
              <span class="text-sm font-semibold text-danger">Invalid JSON</span>
            </div>
            <p class="text-sm text-ink-secondary"><%= result.error %></p>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <div class="bg-white border border-border rounded-xl p-6">
        <h3 class="text-sm font-semibold text-ink mb-2">Features</h3>
        <ul class="space-y-2.5 text-[13px] text-ink-secondary">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-success mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span><strong class="text-ink">Validate</strong> -- Check if JSON is well-formed</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-success mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span><strong class="text-ink">Repair</strong> -- Fix broken JSON (missing quotes, trailing commas, comments)</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-success mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span><strong class="text-ink">Format</strong> -- Pretty-print with proper indentation</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-success mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span><strong class="text-ink">Minify</strong> -- Compact single-line output</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-success mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span><strong class="text-ink">Analyze</strong> -- Statistics on keys, depth, types</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-success mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span><strong class="text-ink">Visualize</strong> -- Interactive node graph like JSON Crack</span>
          </li>
        </ul>
        <div class="mt-5 pt-5 border-t border-border">
          <p class="text-[12px] text-ink-muted">Supports paste input or file upload (.json, .txt, .log). Files up to 10 MB.</p>
        </div>
      </div>
    <% } %>
  </div>
</div>

<!-- Visualizer Overlay -->
<div id="visualizer-overlay" class="fixed inset-0 z-50 hidden" style="background: #f7f8f9;">
  <div class="absolute top-0 left-0 right-0 h-12 bg-white border-b border-border flex items-center justify-between px-4 z-10">
    <div class="flex items-center gap-3">
      <svg class="w-4 h-4 text-brand" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3.75H6A2.25 2.25 0 0 0 3.75 6v1.5M16.5 3.75H18A2.25 2.25 0 0 1 20.25 6v1.5m0 9V18A2.25 2.25 0 0 1 18 20.25h-1.5m-9 0H6A2.25 2.25 0 0 1 3.75 18v-1.5M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
      <span class="text-sm font-semibold text-ink">JSON Visualizer</span>
      <span class="text-[11px] text-ink-muted">Click to expand · Right-click to copy field · ⌘C to copy node · Scroll to zoom</span>
    </div>
    <div class="flex items-center gap-1.5">
      <!-- Search -->
      <div class="relative flex items-center">
        <svg class="w-3.5 h-3.5 text-ink-muted absolute left-2.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
        <input type="text" id="viz-search-input" placeholder="Search…" autocomplete="off"
               class="w-44 pl-8 pr-2 py-1.5 text-[12px] rounded-md border border-border bg-page text-ink focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand" />
        <span id="viz-search-count" class="text-[11px] text-ink-muted ml-1.5 min-w-[3rem] hidden"></span>
        <button type="button" id="viz-search-prev" class="p-1 rounded hover:bg-page transition-colors hidden" title="Previous match (Shift+Enter)">
          <svg class="w-3.5 h-3.5 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5" /></svg>
        </button>
        <button type="button" id="viz-search-next" class="p-1 rounded hover:bg-page transition-colors hidden" title="Next match (Enter)">
          <svg class="w-3.5 h-3.5 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
        </button>
      </div>
      <div class="w-px h-5 bg-border mx-1"></div>
      <button type="button" id="viz-zoom-in" class="p-1.5 rounded-md hover:bg-page transition-colors" title="Zoom in">
        <svg class="w-4 h-4 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      </button>
      <button type="button" id="viz-zoom-out" class="p-1.5 rounded-md hover:bg-page transition-colors" title="Zoom out">
        <svg class="w-4 h-4 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" /></svg>
      </button>
      <button type="button" id="viz-fit" class="p-1.5 rounded-md hover:bg-page transition-colors" title="Fit to view">
        <svg class="w-4 h-4 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5 5.25 5.25" /></svg>
      </button>
      <div class="w-px h-5 bg-border mx-1"></div>
      <button type="button" id="viz-close" class="p-1.5 rounded-md hover:bg-red-50 transition-colors" title="Close">
        <svg class="w-4 h-4 text-ink-secondary hover:text-danger" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>
  <div id="visualizer-container" class="absolute top-12 left-0 right-0 bottom-0">
    <canvas id="json-viz-canvas"></canvas>
  </div>
</div>

<script src="/js/json-visualizer.js"></script>
<script>
  function loadFile(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('json-input').value = e.target.result;
        document.getElementById('file-name').textContent = input.files[0].name;
      };
      reader.readAsText(input.files[0]);
    }
  }

  function copyToClipboard(elementId) {
    const text = document.getElementById(elementId).textContent;
    navigator.clipboard.writeText(text).then(() => {
      const btn = event.target;
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = orig; }, 2000);
    });
  }

  // Visualizer wiring
  (function () {
    var btnVisualize = document.getElementById('btn-visualize');
    if (!btnVisualize) return;

    var overlay = document.getElementById('visualizer-overlay');
    var canvas = document.getElementById('json-viz-canvas');
    var vizCtrl = null;

    btnVisualize.addEventListener('click', function () {
      var rawEl = document.getElementById('viz-raw-json');
      if (!rawEl) return;
      var jsonText = rawEl.value;
      try {
        var data = JSON.parse(jsonText);
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(function () {
          vizCtrl = window.initJsonVisualizer(canvas, data);
        });
      } catch (e) {
        alert('Cannot visualize: invalid JSON');
      }
    });

    document.getElementById('viz-close').addEventListener('click', function () {
      overlay.classList.add('hidden');
      document.body.style.overflow = '';
    });

    document.getElementById('viz-zoom-in').addEventListener('click', function () {
      if (vizCtrl) vizCtrl.zoomIn();
    });
    document.getElementById('viz-zoom-out').addEventListener('click', function () {
      if (vizCtrl) vizCtrl.zoomOut();
    });
    document.getElementById('viz-fit').addEventListener('click', function () {
      if (vizCtrl) vizCtrl.fitToView();
    });

    // Search wiring
    var searchInput = document.getElementById('viz-search-input');
    var searchCount = document.getElementById('viz-search-count');
    var searchPrev = document.getElementById('viz-search-prev');
    var searchNext = document.getElementById('viz-search-next');
    var searchDebounce = null;

    function updateSearchCount(index, total) {
      if (total > 0) {
        searchCount.textContent = (index + 1) + ' / ' + total;
        searchCount.classList.remove('hidden');
        searchPrev.classList.remove('hidden');
        searchNext.classList.remove('hidden');
      } else if (searchInput.value.length > 0) {
        searchCount.textContent = '0 results';
        searchCount.classList.remove('hidden');
        searchPrev.classList.add('hidden');
        searchNext.classList.add('hidden');
      } else {
        searchCount.classList.add('hidden');
        searchPrev.classList.add('hidden');
        searchNext.classList.add('hidden');
      }
    }

    searchInput.addEventListener('input', function () {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(function () {
        if (!vizCtrl) return;
        var q = searchInput.value.trim();
        if (!q) {
          vizCtrl.clearSearch();
          updateSearchCount(-1, 0);
          return;
        }
        var total = vizCtrl.search(q);
        if (total > 0) {
          var r = vizCtrl.searchNext();
          updateSearchCount(r.index, r.total);
        } else {
          updateSearchCount(-1, 0);
        }
      }, 200);
    });

    searchInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && vizCtrl) {
        e.preventDefault();
        if (e.shiftKey) {
          var r = vizCtrl.searchPrev();
          updateSearchCount(r.index, r.total);
        } else {
          var r = vizCtrl.searchNext();
          updateSearchCount(r.index, r.total);
        }
      }
    });

    searchPrev.addEventListener('click', function () {
      if (!vizCtrl) return;
      var r = vizCtrl.searchPrev();
      updateSearchCount(r.index, r.total);
    });

    searchNext.addEventListener('click', function () {
      if (!vizCtrl) return;
      var r = vizCtrl.searchNext();
      updateSearchCount(r.index, r.total);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }
      // ⌘F / Ctrl+F to focus search when overlay is open
      if ((e.metaKey || e.ctrlKey) && e.key === 'f' && !overlay.classList.contains('hidden')) {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      }
    });
  })();
</script>

<%- include('../partials/footer') %>
