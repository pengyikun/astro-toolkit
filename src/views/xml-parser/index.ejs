<%- include('../partials/header') %>

<div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
  <!-- Left Panel: Input -->
  <div class="lg:col-span-3">
    <div class="bg-white border border-border rounded-xl p-6">
      <h2 class="text-xl font-semibold text-ink mb-1">Smart XML Parser</h2>
      <p class="text-[13px] text-ink-secondary mb-6">Parse, validate, format XML and convert to JSON. Paste text or upload a file.</p>

      <form method="POST" action="/xml-parser/parse" enctype="multipart/form-data">
        <div class="mb-4">
          <label for="xml-input" class="block text-xs font-medium text-ink-secondary uppercase tracking-wider mb-2">XML Input</label>
          <textarea name="input" id="xml-input" rows="14"
                    placeholder='Paste your XML here... e.g. <root><item id="1">Hello</item></root>'
                    class="block w-full rounded-lg border border-input-border px-4 py-3 text-sm font-mono leading-relaxed focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand resize-y"><%= input || '' %></textarea>
        </div>

        <div class="flex items-center gap-3 mb-4">
          <span class="text-xs text-ink-muted">or</span>
          <label for="xml-file" class="inline-flex items-center gap-2 px-3.5 py-2 text-sm font-medium rounded-lg border border-border text-ink-secondary hover:bg-page cursor-pointer transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>
            Upload File
            <input type="file" id="xml-file" name="file" accept=".xml,.xsd,.xsl,.xslt,.svg,.html,.htm,.txt" class="hidden" onchange="loadFile(this)">
          </label>
          <span id="file-name" class="text-xs text-ink-muted"></span>
        </div>

        <button type="submit"
                class="px-5 py-2.5 text-sm font-medium rounded-lg bg-brand text-white hover:bg-brand-dark transition-colors">
          Parse &amp; Validate
        </button>
      </form>
    </div>
  </div>

  <!-- Right Panel: Result -->
  <div class="lg:col-span-2">
    <% if (result) { %>
      <% if (result.valid) { %>
        <div class="bg-white border border-border rounded-xl overflow-hidden">
          <div class="px-5 py-4 border-b border-border">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#0d7d4d]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              <span class="text-sm font-semibold text-[#0d7d4d]">Valid XML</span>
            </div>
          </div>

          <% if (result.stats) { %>
            <div class="px-5 py-3 border-b border-border bg-page/50">
              <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-[12px]">
                <div class="flex justify-between"><span class="text-ink-muted">Elements</span><span class="text-ink font-medium"><%= result.stats.elementCount %></span></div>
                <div class="flex justify-between"><span class="text-ink-muted">Attributes</span><span class="text-ink font-medium"><%= result.stats.attributeCount %></span></div>
                <div class="flex justify-between"><span class="text-ink-muted">Text Nodes</span><span class="text-ink font-medium"><%= result.stats.textNodeCount %></span></div>
                <div class="flex justify-between"><span class="text-ink-muted">Max Depth</span><span class="text-ink font-medium"><%= result.stats.depth %></span></div>
                <div class="flex justify-between"><span class="text-ink-muted">Size</span><span class="text-ink font-medium"><%= result.stats.size %> B</span></div>
              </div>
            </div>
          <% } %>

          <!-- Tab navigation -->
          <div class="px-5 pt-3 border-b border-border">
            <div class="flex gap-4">
              <button type="button" onclick="showTab('xml-tab')" class="xml-tab-btn tab-btn text-[12px] font-medium pb-2.5 border-b-2 border-brand text-brand" data-tab="xml-tab">Formatted XML</button>
              <button type="button" onclick="showTab('json-tab')" class="json-tab-btn tab-btn text-[12px] font-medium pb-2.5 border-b-2 border-transparent text-ink-secondary hover:text-ink" data-tab="json-tab">JSON Output</button>
            </div>
          </div>

          <div id="xml-tab" class="px-5 py-3">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[11px] font-semibold text-ink-secondary uppercase tracking-wider">XML</span>
              <button type="button" onclick="copyToClipboard('xml-output')" class="text-[11px] text-brand hover:text-brand-dark font-medium">Copy</button>
            </div>
            <pre id="xml-output" class="bg-page rounded-lg p-4 text-xs text-ink font-mono overflow-x-auto whitespace-pre-wrap max-h-96 overflow-y-auto border border-border"><%= result.formatted %></pre>
          </div>

          <div id="json-tab" class="px-5 py-3 hidden">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[11px] font-semibold text-ink-secondary uppercase tracking-wider">JSON</span>
              <button type="button" onclick="copyToClipboard('json-output')" class="text-[11px] text-brand hover:text-brand-dark font-medium">Copy</button>
            </div>
            <pre id="json-output" class="bg-page rounded-lg p-4 text-xs text-ink font-mono overflow-x-auto whitespace-pre-wrap max-h-96 overflow-y-auto border border-border"><%= result.toJson %></pre>
          </div>
        </div>
      <% } else { %>
        <div class="bg-white border border-border rounded-xl border-l-4 border-l-[#cd3d64] overflow-hidden">
          <div class="px-5 py-5">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-[#cd3d64]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
              <span class="text-sm font-semibold text-[#cd3d64]">Invalid XML</span>
            </div>
            <p class="text-sm text-ink-secondary"><%= result.error %></p>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <div class="bg-white border border-border rounded-xl p-6">
        <h3 class="text-sm font-semibold text-ink mb-2">Features</h3>
        <ul class="space-y-2.5 text-[13px] text-ink-secondary">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-[#0d7d4d] mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span><strong class="text-ink">Validate</strong> -- Check XML well-formedness</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-[#0d7d4d] mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span><strong class="text-ink">Format</strong> -- Pretty-print with indentation</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-[#0d7d4d] mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span><strong class="text-ink">Convert to JSON</strong> -- Transform XML to JSON structure</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-[#0d7d4d] mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span><strong class="text-ink">Analyze</strong> -- Count elements, attributes, depth</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-[#0d7d4d] mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            <span><strong class="text-ink">Attributes</strong> -- Preserves namespaces and attributes</span>
          </li>
        </ul>
        <div class="mt-5 pt-5 border-t border-border">
          <p class="text-[12px] text-ink-muted">Supports paste input or file upload (.xml, .xsd, .xsl, .svg, .html). Files up to 10 MB.</p>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
  function loadFile(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('xml-input').value = e.target.result;
        document.getElementById('file-name').textContent = input.files[0].name;
      };
      reader.readAsText(input.files[0]);
    }
  }

  function copyToClipboard(elementId) {
    const text = document.getElementById(elementId).textContent;
    navigator.clipboard.writeText(text).then(() => {
      const btn = event.target;
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = orig; }, 2000);
    });
  }

  function showTab(tabId) {
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.classList.remove('border-brand', 'text-brand');
      btn.classList.add('border-transparent', 'text-ink-secondary');
    });
    document.querySelectorAll('[id$="-tab"]').forEach(el => {
      if (el.id === tabId) {
        el.classList.remove('hidden');
      } else if (el.id.endsWith('-tab') && el.id !== tabId) {
        el.classList.add('hidden');
      }
    });
    const activeBtn = document.querySelector(`[data-tab="${tabId}"]`);
    if (activeBtn) {
      activeBtn.classList.remove('border-transparent', 'text-ink-secondary');
      activeBtn.classList.add('border-brand', 'text-brand');
    }
  }
</script>

<%- include('../partials/footer') %>
