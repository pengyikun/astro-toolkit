<%- include('../partials/header') %>

<section class="page-header">
  <div class="page-breadcrumbs">
    <span>Validation</span>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
    </svg>
    <span>XML parser</span>
  </div>

  <div>
    <h1 class="console-title">XML parser</h1>
  </div>
</section>

<div class="grid grid-cols-1 <%= result ? 'lg:grid-cols-5' : '' %> gap-6 mt-8">
  <!-- Left Panel: Input -->
  <div class="<%= result ? 'lg:col-span-3' : '' %>">
    <div class="console-panel">
      <div class="console-panel-body">
      <form method="POST" action="/xml-parser/parse" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="code-editor">
          <div class="code-editor-toolbar">
            <label for="xml-input" class="console-inline-label">XML input</label>
            <div class="code-editor-toolbar-actions">
              <label for="xml-file" class="console-button-secondary cursor-pointer">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>
                Upload file
                <input type="file" id="xml-file" name="file" class="hidden" onchange="loadFile(this)">
              </label>
              <span id="file-name" class="text-xs text-ink-muted"></span>
            </div>
          </div>
          <div class="code-editor-shell" data-code-editor>
            <div class="code-editor-gutter" data-code-gutter aria-hidden="true"></div>
            <div class="code-editor-stage">
              <pre class="code-editor-highlight" data-code-highlight aria-hidden="true"></pre>
              <textarea
                name="input"
                id="xml-input"
                rows="16"
                placeholder='<root><item id="1">Hello</item></root>'
                class="code-editor-input"
                data-language="xml"
                spellcheck="false"
              ><%= input || '' %></textarea>
            </div>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button type="submit" class="console-button-primary">
            Parse &amp; Validate
          </button>
          <label for="xml-file" class="console-text-action inline-flex items-center gap-2 cursor-pointer">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>
            Replace from file
          </label>
        </div>
      </form>
      </div>
    </div>
  </div>

  <!-- Right Panel: Result -->
  <% if (result) { %>
  <div class="lg:col-span-2">
    <% if (result) { %>
      <% if (result.valid) { %>
        <div class="console-panel overflow-hidden">
          <div class="px-5 py-4 border-b border-border">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              <span class="text-sm font-semibold text-success">Valid XML</span>
            </div>
          </div>

          <% if (result.stats) { %>
            <div class="px-5 py-3 border-b border-border bg-page/50">
              <div class="console-stats-grid">
                <div class="console-stats-row"><span>Elements</span><strong><%= result.stats.elementCount %></strong></div>
                <div class="console-stats-row"><span>Attributes</span><strong><%= result.stats.attributeCount %></strong></div>
                <div class="console-stats-row"><span>Text nodes</span><strong><%= result.stats.textNodeCount %></strong></div>
                <div class="console-stats-row"><span>Max depth</span><strong><%= result.stats.depth %></strong></div>
                <div class="console-stats-row"><span>Size</span><strong><%= result.stats.size %> B</strong></div>
              </div>
            </div>
          <% } %>

          <!-- Tab navigation -->
          <div class="px-5 pt-3 border-b border-border">
            <div class="console-tab-list">
              <button type="button" onclick="showTab('xml-tab')" class="xml-tab-btn tab-btn console-tab-button is-active" data-tab="xml-tab">Formatted XML</button>
              <button type="button" onclick="showTab('json-tab')" class="json-tab-btn tab-btn console-tab-button" data-tab="json-tab">JSON output</button>
            </div>
          </div>

          <div id="xml-tab" class="px-5 py-3">
            <div class="flex items-center gap-2 mb-2">
              <span class="console-inline-label">XML</span>
              <button type="button" onclick="copyToClipboard('xml-output', this)" class="console-text-action">Copy</button>
            </div>
            <pre id="xml-output" class="bg-page rounded-lg p-4 text-xs text-ink font-mono overflow-x-auto whitespace-pre-wrap max-h-96 overflow-y-auto border border-border"><%= result.formatted %></pre>
          </div>

          <div id="json-tab" class="px-5 py-3 hidden">
            <div class="flex items-center gap-2 mb-2">
              <span class="console-inline-label">JSON</span>
              <button type="button" onclick="copyToClipboard('json-output', this)" class="console-text-action">Copy</button>
            </div>
            <pre id="json-output" class="bg-page rounded-lg p-4 text-xs text-ink font-mono overflow-x-auto whitespace-pre-wrap max-h-96 overflow-y-auto border border-border"><%= result.toJson %></pre>
          </div>

          <div class="px-5 py-3 border-t border-border">
            <button type="button" id="btn-visualize-xml"
                    class="console-button-secondary">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3.75H6A2.25 2.25 0 0 0 3.75 6v1.5M16.5 3.75H18A2.25 2.25 0 0 1 20.25 6v1.5m0 9V18A2.25 2.25 0 0 1 18 20.25h-1.5m-9 0H6A2.25 2.25 0 0 1 3.75 18v-1.5M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
              Visualize XML
            </button>
          </div>
          <textarea id="viz-raw-xml-json" class="hidden" aria-hidden="true"><%= result.toJson %></textarea>
        </div>
      <% } else { %>
        <div class="console-panel overflow-hidden border-l-4 border-l-danger">
          <div class="px-5 py-5">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-danger" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
              <span class="text-sm font-semibold text-danger">Invalid XML</span>
            </div>
            <p class="text-sm text-ink-secondary"><%= result.error %></p>
          </div>
        </div>
      <% } %>
    <% } %>
  </div>
  <% } %>
</div>

<!-- Visualizer Overlay -->
<div id="xml-visualizer-overlay" class="fixed inset-0 z-50 hidden" style="background: #f7f8f9;">
  <div class="absolute top-0 left-0 right-0 h-12 bg-white border-b border-border flex items-center justify-between px-4 z-10">
    <div class="flex items-center gap-3">
      <svg class="w-4 h-4 text-brand" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3.75H6A2.25 2.25 0 0 0 3.75 6v1.5M16.5 3.75H18A2.25 2.25 0 0 1 20.25 6v1.5m0 9V18A2.25 2.25 0 0 1 18 20.25h-1.5m-9 0H6A2.25 2.25 0 0 1 3.75 18v-1.5M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
      <span class="text-sm font-semibold text-ink">XML Visualizer</span>
      <span class="text-[11px] text-ink-muted">Click to expand · Right-click to copy field · ⌘C to copy node · Scroll to zoom</span>
    </div>
    <div class="flex items-center gap-1.5">
      <!-- Search -->
      <div class="relative flex items-center">
        <svg class="w-3.5 h-3.5 text-ink-muted absolute left-2.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
        <input type="text" id="xml-viz-search-input" placeholder="Search…" autocomplete="off"
               class="w-44 pl-8 pr-2 py-1.5 text-[12px] rounded-md border border-border bg-page text-ink focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand" />
        <span id="xml-viz-search-count" class="text-[11px] text-ink-muted ml-1.5 min-w-[3rem] hidden"></span>
        <button type="button" id="xml-viz-search-prev" class="p-1 rounded hover:bg-page transition-colors hidden" title="Previous match (Shift+Enter)">
          <svg class="w-3.5 h-3.5 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5" /></svg>
        </button>
        <button type="button" id="xml-viz-search-next" class="p-1 rounded hover:bg-page transition-colors hidden" title="Next match (Enter)">
          <svg class="w-3.5 h-3.5 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
        </button>
      </div>
      <div class="w-px h-5 bg-border mx-1"></div>
      <button type="button" id="xml-viz-zoom-in" class="p-1.5 rounded-md hover:bg-page transition-colors" title="Zoom in">
        <svg class="w-4 h-4 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      </button>
      <button type="button" id="xml-viz-zoom-out" class="p-1.5 rounded-md hover:bg-page transition-colors" title="Zoom out">
        <svg class="w-4 h-4 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" /></svg>
      </button>
      <button type="button" id="xml-viz-fit" class="p-1.5 rounded-md hover:bg-page transition-colors" title="Fit to view">
        <svg class="w-4 h-4 text-ink-secondary" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5 5.25 5.25" /></svg>
      </button>
      <div class="w-px h-5 bg-border mx-1"></div>
      <button type="button" id="xml-viz-close" class="p-1.5 rounded-md hover:bg-red-50 transition-colors" title="Close">
        <svg class="w-4 h-4 text-ink-secondary hover:text-danger" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>
  <div id="xml-visualizer-container" class="absolute top-12 left-0 right-0 bottom-0">
    <canvas id="xml-viz-canvas"></canvas>
  </div>
</div>

<script src="/js/parser-editor.js"></script>
<script src="/js/json-visualizer.js"></script>
<script src="/js/xml-visualizer.js"></script>
<script>
  function loadFile(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        var editor = document.getElementById('xml-input');
        editor.value = e.target.result;
        editor.dispatchEvent(new Event('input', { bubbles: true }));
        document.getElementById('file-name').textContent = input.files[0].name;
      };
      reader.readAsText(input.files[0]);
    }
  }

  function copyToClipboard(elementId, button) {
    const text = document.getElementById(elementId).textContent;
    var originalLabel = button ? button.textContent : '';

    function showCopiedState(label) {
      if (!button) return;
      button.textContent = label;
      setTimeout(function () { button.textContent = originalLabel; }, 2000);
    }

    if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
      window.prompt('Copy this value:', text);
      showCopiedState('Shown');
      return;
    }

    navigator.clipboard.writeText(text).then(function () {
      showCopiedState('Copied!');
    }).catch(function () {
      window.prompt('Copy this value:', text);
      showCopiedState('Shown');
    });
  }

  function showTab(tabId) {
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.classList.remove('is-active');
    });
    var tabIds = ['xml-tab', 'json-tab'];
    tabIds.forEach(function (id) {
      var el = document.getElementById(id);
      if (!el) return;
      if (id === tabId) { el.classList.remove('hidden'); }
      else { el.classList.add('hidden'); }
    });
    const activeBtn = document.querySelector(`[data-tab="${tabId}"]`);
    if (activeBtn) {
      activeBtn.classList.add('is-active');
    }
  }

  // Visualizer wiring
  (function () {
    var btnVisualize = document.getElementById('btn-visualize-xml');
    if (!btnVisualize) return;

    var overlay = document.getElementById('xml-visualizer-overlay');
    var canvas = document.getElementById('xml-viz-canvas');
    var vizCtrl = null;

    btnVisualize.addEventListener('click', function () {
      var rawEl = document.getElementById('viz-raw-xml-json');
      if (!rawEl) return;
      var jsonText = rawEl.value;
      try {
        var data = JSON.parse(jsonText);
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(function () {
          vizCtrl = window.initXmlVisualizer(canvas, data);
        });
      } catch (e) {
        alert('Cannot visualize: failed to parse XML-to-JSON data');
      }
    });

    document.getElementById('xml-viz-close').addEventListener('click', function () {
      overlay.classList.add('hidden');
      document.body.style.overflow = '';
    });

    document.getElementById('xml-viz-zoom-in').addEventListener('click', function () {
      if (vizCtrl) vizCtrl.zoomIn();
    });
    document.getElementById('xml-viz-zoom-out').addEventListener('click', function () {
      if (vizCtrl) vizCtrl.zoomOut();
    });
    document.getElementById('xml-viz-fit').addEventListener('click', function () {
      if (vizCtrl) vizCtrl.fitToView();
    });

    // Search wiring
    var searchInput = document.getElementById('xml-viz-search-input');
    var searchCount = document.getElementById('xml-viz-search-count');
    var searchPrev = document.getElementById('xml-viz-search-prev');
    var searchNext = document.getElementById('xml-viz-search-next');
    var searchDebounce = null;

    function updateSearchCount(index, total) {
      if (total > 0) {
        searchCount.textContent = (index + 1) + ' / ' + total;
        searchCount.classList.remove('hidden');
        searchPrev.classList.remove('hidden');
        searchNext.classList.remove('hidden');
      } else if (searchInput.value.length > 0) {
        searchCount.textContent = '0 results';
        searchCount.classList.remove('hidden');
        searchPrev.classList.add('hidden');
        searchNext.classList.add('hidden');
      } else {
        searchCount.classList.add('hidden');
        searchPrev.classList.add('hidden');
        searchNext.classList.add('hidden');
      }
    }

    searchInput.addEventListener('input', function () {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(function () {
        if (!vizCtrl) return;
        var q = searchInput.value.trim();
        if (!q) {
          vizCtrl.clearSearch();
          updateSearchCount(-1, 0);
          return;
        }
        var total = vizCtrl.search(q);
        if (total > 0) {
          var r = vizCtrl.searchNext();
          updateSearchCount(r.index, r.total);
        } else {
          updateSearchCount(-1, 0);
        }
      }, 200);
    });

    searchInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && vizCtrl) {
        e.preventDefault();
        if (e.shiftKey) {
          var r = vizCtrl.searchPrev();
          updateSearchCount(r.index, r.total);
        } else {
          var r = vizCtrl.searchNext();
          updateSearchCount(r.index, r.total);
        }
      }
    });

    searchPrev.addEventListener('click', function () {
      if (!vizCtrl) return;
      var r = vizCtrl.searchPrev();
      updateSearchCount(r.index, r.total);
    });

    searchNext.addEventListener('click', function () {
      if (!vizCtrl) return;
      var r = vizCtrl.searchNext();
      updateSearchCount(r.index, r.total);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'f' && !overlay.classList.contains('hidden')) {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      }
    });
  })();
</script>

<%- include('../partials/footer') %>
