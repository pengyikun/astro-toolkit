<%- include('../partials/header') %>

<section class="page-header">
  <div class="page-breadcrumbs">
    <span>Validation</span>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
    </svg>
    <span>IBAN checker</span>
  </div>

  <div>
    <h1 class="console-title">IBAN checker</h1>
  </div>
</section>

<div class="section-stack">
  <section class="section-block">
    <div class="console-panel">
      <div class="console-panel-body">
        <form method="POST" action="/iban/check" id="iban-form" class="space-y-4">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <label for="iban-input" class="console-label">Enter IBAN</label>
          <div class="flex flex-col gap-3 sm:flex-row">
            <input type="text" name="iban" id="iban-input"
                   value="<%= input %>"
                   placeholder="e.g. GB29 NWBK 6016 1331 9268 19"
                   autocomplete="off"
                   class="console-input flex-1 font-mono text-base tracking-[0.16em]">
            <button type="submit" id="iban-submit" class="console-button-primary whitespace-nowrap sm:min-w-[8rem] flex items-center justify-center gap-2">
              <svg id="iban-spinner" class="hidden animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="iban-btn-text">Validate</span>
            </button>
          </div>
        </form>

        <div class="helper-list mt-5">
          <div class="helper-row">
            <svg class="w-4 h-4 text-ink-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
            </svg>
            <span>Spaces and casing are ignored. The checker supports SEPA, UK, and broader cross-border formats.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <% if (result) { %>
    <section class="section-block">
      <% if (result.valid) { %>
        <!-- IBAN Parse Result -->
        <div class="console-panel overflow-hidden border-l-4 border-l-success">
          <div class="px-6 pt-6 pb-4">
            <div class="flex items-center gap-2 mb-4">
              <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              <span class="text-sm font-semibold text-success">Valid IBAN</span>
            </div>
            <div class="font-mono text-base tracking-widest text-ink bg-page rounded-lg px-4 py-3 text-center">
              <%= result.iban_formatted || result.iban %>
            </div>
          </div>
          <div class="px-6 pb-6">
            <dl class="grid grid-cols-1 gap-x-8 divide-y divide-border sm:grid-cols-2 sm:divide-y-0">
              <div class="space-y-0 divide-y divide-border">
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Country</dt>
                  <dd class="text-sm text-ink"><%= result.country_name %> (<%= result.country_code %>)</dd>
                </div>
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Check Digits</dt>
                  <dd class="text-sm text-ink font-mono"><%= result.check_digits %></dd>
                </div>
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">BBAN</dt>
                  <dd class="text-sm text-ink font-mono"><%= result.bban %></dd>
                </div>
              </div>
              <div class="space-y-0 divide-y divide-border">
                <% if (result.bank_identifier) { %>
                  <div class="flex justify-between py-3">
                    <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Bank Identifier</dt>
                    <dd class="text-sm text-ink font-mono"><%= result.bank_identifier %></dd>
                  </div>
                <% } %>
                <% if (result.branch_identifier) { %>
                  <div class="flex justify-between py-3">
                    <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Branch Identifier</dt>
                    <dd class="text-sm text-ink font-mono"><%= result.branch_identifier %></dd>
                  </div>
                <% } %>
                <% if (result.account_number) { %>
                  <div class="flex justify-between py-3">
                    <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Account Number</dt>
                    <dd class="text-sm text-ink font-mono"><%= result.account_number %></dd>
                  </div>
                <% } %>
              </div>
            </dl>

            <% if (leiEntity) { %>
              <div class="border-t border-border mt-3 pt-3">
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">LEI</dt>
                  <dd class="text-sm text-ink font-mono"><%= leiEntity.lei %></dd>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <% if (leiEntity) { %>
          <!-- Issuing Institution Details (from GLEIF) -->
          <div class="console-panel overflow-hidden mt-4">
            <div class="px-6 pt-5 pb-2">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" /></svg>
                <h2 class="text-base font-semibold text-ink">Issuing Institution</h2>
              </div>
              <p class="text-sm text-ink mt-1 ml-8"><%= leiEntity.legalName %></p>
              <% if (leiEntity.otherNames && leiEntity.otherNames.length > 0) { %>
                <p class="text-xs text-ink-muted mt-0.5 ml-8">Also known as: <%= leiEntity.otherNames.join(', ') %></p>
              <% } %>
            </div>

            <!-- Entity Information -->
            <div class="px-6 py-4 border-t border-border">
              <h3 class="text-[11px] font-semibold text-ink-muted uppercase tracking-wider mb-3">Entity Information</h3>
              <dl class="grid grid-cols-1 gap-x-8 sm:grid-cols-2">
                <div class="space-y-0 divide-y divide-border">
                  <div class="flex justify-between items-center py-2.5">
                    <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Entity Status</dt>
                    <dd>
                      <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= leiEntity.status === 'ACTIVE' ? 'bg-success-light text-success' : 'bg-page text-ink-secondary' %>">
                        <%= leiEntity.status %>
                      </span>
                    </dd>
                  </div>
                  <% if (leiEntity.jurisdiction) { %>
                    <div class="flex justify-between py-2.5">
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Jurisdiction</dt>
                      <dd class="text-sm text-ink"><%= leiEntity.jurisdiction %></dd>
                    </div>
                  <% } %>
                  <% if (leiEntity.category) { %>
                    <div class="flex justify-between py-2.5">
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Category</dt>
                      <dd class="text-sm text-ink"><%= leiEntity.category.replace(/_/g, ' ').toLowerCase().replace(/^./, c => c.toUpperCase()) %></dd>
                    </div>
                  <% } %>
                </div>
                <div class="space-y-0 divide-y divide-border">
                  <% if (leiEntity.legalForm && (leiEntity.legalForm.id || leiEntity.legalForm.other)) { %>
                    <div class="flex justify-between py-2.5">
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Legal Form</dt>
                      <dd class="text-sm text-ink"><%= leiEntity.legalForm.other || leiEntity.legalForm.id %></dd>
                    </div>
                  <% } %>
                  <% if (leiEntity.registeredAs) { %>
                    <div class="flex justify-between py-2.5">
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Registration Number</dt>
                      <dd class="text-sm text-ink font-mono"><%= leiEntity.registeredAs %></dd>
                    </div>
                  <% } %>
                  <% if (leiEntity.registeredAt) { %>
                    <div class="flex justify-between py-2.5">
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Registration Authority</dt>
                      <dd class="text-sm text-ink"><%= leiEntity.registeredAt %></dd>
                    </div>
                  <% } %>
                </div>
              </dl>
            </div>

            <!-- Addresses -->
            <%
              const legalAddr = leiEntity.legalAddress;
              const hasLegalAddr = legalAddr && (legalAddr.addressLines.length > 0 || legalAddr.city || legalAddr.country);
              const hqAddr = leiEntity.headquartersAddress;
              const hasHqAddr = hqAddr && (hqAddr.addressLines.length > 0 || hqAddr.city || hqAddr.country);
              const hqDiffers = hasHqAddr && JSON.stringify(hqAddr) !== JSON.stringify(legalAddr);
            %>
            <% if (hasLegalAddr || hqDiffers) { %>
              <div class="px-6 py-4 border-t border-border">
                <h3 class="text-[11px] font-semibold text-ink-muted uppercase tracking-wider mb-3">Addresses</h3>
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                  <% if (hasLegalAddr) { %>
                    <div>
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider mb-1.5">Legal Address</dt>
                      <dd class="text-sm text-ink space-y-0.5">
                        <% legalAddr.addressLines.forEach(line => { %>
                          <p><%= line %></p>
                        <% }) %>
                        <p>
                          <%= [legalAddr.city, legalAddr.region].filter(Boolean).join(', ') %>
                          <%= legalAddr.postalCode ? ' ' + legalAddr.postalCode : '' %>
                        </p>
                        <% if (legalAddr.country) { %><p><%= legalAddr.country %></p><% } %>
                      </dd>
                    </div>
                  <% } %>
                  <% if (hqDiffers) { %>
                    <div>
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider mb-1.5">Headquarters Address</dt>
                      <dd class="text-sm text-ink space-y-0.5">
                        <% hqAddr.addressLines.forEach(line => { %>
                          <p><%= line %></p>
                        <% }) %>
                        <p>
                          <%= [hqAddr.city, hqAddr.region].filter(Boolean).join(', ') %>
                          <%= hqAddr.postalCode ? ' ' + hqAddr.postalCode : '' %>
                        </p>
                        <% if (hqAddr.country) { %><p><%= hqAddr.country %></p><% } %>
                      </dd>
                    </div>
                  <% } %>
                </div>
              </div>
            <% } %>

            <!-- Registration Details -->
            <% if (leiEntity.registration) { %>
              <div class="px-6 py-4 border-t border-border">
                <h3 class="text-[11px] font-semibold text-ink-muted uppercase tracking-wider mb-3">LEI Registration</h3>
                <dl class="grid grid-cols-1 gap-x-8 sm:grid-cols-2">
                  <div class="space-y-0 divide-y divide-border">
                    <div class="flex justify-between items-center py-2.5">
                      <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Registration Status</dt>
                      <dd>
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium <%= leiEntity.registration.status === 'ISSUED' ? 'bg-brand-light text-brand' : 'bg-warning-light text-warning' %>">
                          <%= leiEntity.registration.status %>
                        </span>
                      </dd>
                    </div>
                    <% if (leiEntity.registration.initialRegistrationDate) { %>
                      <div class="flex justify-between py-2.5">
                        <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Initial Registration</dt>
                        <dd class="text-sm text-ink"><%= new Date(leiEntity.registration.initialRegistrationDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></dd>
                      </div>
                    <% } %>
                    <% if (leiEntity.registration.lastUpdateDate) { %>
                      <div class="flex justify-between py-2.5">
                        <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Last Updated</dt>
                        <dd class="text-sm text-ink"><%= new Date(leiEntity.registration.lastUpdateDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></dd>
                      </div>
                    <% } %>
                  </div>
                  <div class="space-y-0 divide-y divide-border">
                    <% if (leiEntity.registration.nextRenewalDate) { %>
                      <div class="flex justify-between py-2.5">
                        <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Next Renewal</dt>
                        <dd class="text-sm text-ink"><%= new Date(leiEntity.registration.nextRenewalDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></dd>
                      </div>
                    <% } %>
                    <% if (leiEntity.registration.managingLou) { %>
                      <div class="flex justify-between py-2.5">
                        <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Managing LOU</dt>
                        <dd class="text-sm text-ink font-mono text-xs"><%= leiEntity.registration.managingLou %></dd>
                      </div>
                    <% } %>
                    <% if (leiEntity.registration.corroborationLevel) { %>
                      <div class="flex justify-between py-2.5">
                        <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Corroboration</dt>
                        <dd class="text-sm text-ink"><%= leiEntity.registration.corroborationLevel.replace(/_/g, ' ').toLowerCase().replace(/^./, c => c.toUpperCase()) %></dd>
                      </div>
                    <% } %>
                  </div>
                </dl>
              </div>
            <% } %>
          </div>
        <% } else if (leiSupported && result.bank_identifier) { %>
          <!-- LEI not found but lookup was attempted -->
          <div class="console-panel overflow-hidden mt-4">
            <div class="px-6 py-4">
              <div class="flex items-center gap-2 text-ink-muted">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" /></svg>
                <span class="text-sm">No LEI record found for bank identifier <span class="font-mono font-medium"><%= result.bank_identifier %></span></span>
              </div>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div class="console-panel overflow-hidden border-l-4 border-l-danger">
          <div class="px-6 py-6">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-danger" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
              <span class="text-sm font-semibold text-danger">Invalid IBAN</span>
            </div>
            <% if (input) { %>
              <div class="font-mono text-sm tracking-widest text-ink-secondary bg-page rounded-lg px-4 py-3 text-center mb-4">
                <%= input %>
              </div>
            <% } %>
            <p class="text-sm text-ink-secondary"><%= result.error %></p>
          </div>
        </div>
      <% } %>
    </section>
  <% } %>
</div>

<script>
(function() {
  var form = document.getElementById('iban-form');
  var btn = document.getElementById('iban-submit');
  var spinner = document.getElementById('iban-spinner');
  var btnText = document.getElementById('iban-btn-text');
  var input = document.getElementById('iban-input');

  if (form) {
    form.addEventListener('submit', function() {
      if (!input.value.trim()) return;
      btn.disabled = true;
      btn.classList.add('opacity-75', 'cursor-not-allowed');
      spinner.classList.remove('hidden');
      btnText.textContent = 'Checking\u2026';
    });
  }
})();
</script>

<%- include('../partials/footer') %>
