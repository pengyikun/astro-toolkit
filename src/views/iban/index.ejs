<%- include('../partials/header') %>

<div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
  <!-- Left Panel: Input -->
  <div class="lg:col-span-3">
    <div class="bg-white border border-border rounded-lg p-8">
      <h2 class="text-xl font-semibold text-ink mb-1">IBAN Validator &amp; Parser</h2>
      <p class="text-[13px] text-ink-secondary mb-8">Validate and extract embedded data from International Bank Account Numbers</p>

      <form method="POST" action="/iban/check">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <label for="iban-input" class="block text-xs font-medium text-ink-secondary uppercase tracking-wider mb-2">Enter IBAN</label>
        <div class="flex gap-3">
          <input type="text" name="iban" id="iban-input"
                 value="<%= input %>"
                 placeholder="e.g. GB29 NWBK 6016 1331 9268 19"
                 autocomplete="off"
                 class="block flex-1 rounded-md border border-input-border px-5 py-4 text-lg font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand">
          <button type="submit"
                  class="px-6 py-4 text-sm font-medium rounded-md bg-brand text-white hover:bg-brand-dark transition-colors whitespace-nowrap">
            Validate
          </button>
        </div>
      </form>

      <div class="mt-6 flex items-start gap-2 text-[12px] text-ink-muted">
        <svg class="w-3.5 h-3.5 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" /></svg>
        <span>Spaces and case are ignored. Paste directly from bank documents or spreadsheets.</span>
      </div>
    </div>
  </div>

  <!-- Right Panel: Result or Empty State -->
  <div class="lg:col-span-2">
    <% if (result) { %>
      <% if (result.valid) { %>
        <div class="bg-white border border-border rounded-lg border-l-4 border-l-success overflow-hidden">
          <div class="px-6 pt-6 pb-4">
            <div class="flex items-center gap-2 mb-4">
              <svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              <span class="text-sm font-semibold text-success">Valid IBAN</span>
            </div>
            <div class="font-mono text-base tracking-widest text-ink bg-page rounded-md px-4 py-3 text-center mb-2">
              <%= result.iban_formatted || result.iban %>
            </div>
          </div>
          <div class="px-6 pb-6">
            <dl class="divide-y divide-border">
              <div class="flex justify-between py-3">
                <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Country</dt>
                <dd class="text-sm text-ink"><%= result.country_name %> (<%= result.country_code %>)</dd>
              </div>
              <div class="flex justify-between py-3">
                <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Check Digits</dt>
                <dd class="text-sm text-ink font-mono"><%= result.check_digits %></dd>
              </div>
              <div class="flex justify-between py-3">
                <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">BBAN</dt>
                <dd class="text-sm text-ink font-mono"><%= result.bban %></dd>
              </div>
              <% if (result.bank_identifier) { %>
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Bank Identifier</dt>
                  <dd class="text-sm text-ink font-mono"><%= result.bank_identifier %></dd>
                </div>
              <% } %>
              <% if (result.branch_identifier) { %>
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Branch Identifier</dt>
                  <dd class="text-sm text-ink font-mono"><%= result.branch_identifier %></dd>
                </div>
              <% } %>
              <% if (result.account_number) { %>
                <div class="flex justify-between py-3">
                  <dt class="text-[12px] font-medium text-ink-muted uppercase tracking-wider">Account Number</dt>
                  <dd class="text-sm text-ink font-mono"><%= result.account_number %></dd>
                </div>
              <% } %>
            </dl>
          </div>
        </div>
      <% } else { %>
        <div class="bg-white border border-border rounded-lg border-l-4 border-l-danger overflow-hidden">
          <div class="px-6 py-6">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-danger" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
              <span class="text-sm font-semibold text-danger">Invalid IBAN</span>
            </div>
            <% if (input) { %>
              <div class="font-mono text-sm tracking-widest text-ink-secondary bg-page rounded-md px-4 py-3 text-center mb-4">
                <%= input %>
              </div>
            <% } %>
            <p class="text-sm text-ink-secondary"><%= result.error %></p>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <!-- Empty state: educational content -->
      <div class="bg-white border border-border rounded-lg p-6">
        <h3 class="text-sm font-semibold text-ink mb-1">What is an IBAN?</h3>
        <p class="text-[13px] text-ink-secondary mb-5">An International Bank Account Number uniquely identifies a bank account for cross-border transactions.</p>

        <div class="space-y-4 text-[13px]">
          <div>
            <h4 class="font-medium text-ink mb-1">Format</h4>
            <p class="text-ink-secondary">Up to 34 alphanumeric characters: 2-letter country code, 2 check digits, then the BBAN (Basic Bank Account Number).</p>
          </div>
          <div>
            <h4 class="font-medium text-ink mb-1">Example</h4>
            <p class="font-mono text-ink-secondary tracking-wider">GB29 NWBK 6016 1331 9268 19</p>
          </div>
          <div>
            <h4 class="font-medium text-ink mb-1">Validation</h4>
            <ul class="text-ink-muted space-y-1.5 list-none">
              <li class="flex items-start gap-2">
                <span class="text-ink-muted mt-px">·</span>
                Country code &amp; length verification
              </li>
              <li class="flex items-start gap-2">
                <span class="text-ink-muted mt-px">·</span>
                BBAN format check per country
              </li>
              <li class="flex items-start gap-2">
                <span class="text-ink-muted mt-px">·</span>
                MOD-97 check digit verification
              </li>
              <li class="flex items-start gap-2">
                <span class="text-ink-muted mt-px">·</span>
                Bank &amp; branch identifier extraction
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-5 pt-5 border-t border-border">
          <p class="text-[12px] text-ink-muted">Supports <span class="font-medium">70+</span> country formats including SEPA, UK, US-adjacent territories, and Middle East.</p>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
