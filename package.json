    "knex": "^3.1.0",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.5",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
